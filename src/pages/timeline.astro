			<script is:inline>
				(function () {
					var root = document.currentScript.parentElement;
					var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
					var tablist = root.querySelector('[role="tablist"]');

					function idFromHash() {
						return location.hash === '#season-2' ? 'season-2' : 'season-1';
					}

					function select(id, options) {
						var updateHash = !options || options.updateHash !== false;
						var fromClick = options && options.fromClick;

						tabs.forEach(function (tab) {
							var selected = tab.id === 'tab-' + id;
							tab.setAttribute('aria-selected', selected ? 'true' : 'false');
							tab.tabIndex = selected ? 0 : -1;
							var panel = document.getElementById(tab.getAttribute('aria-controls'));
							if (!panel) return;
							if (selected) panel.removeAttribute('hidden');
							else panel.setAttribute('hidden', '');
						});

						tablist.setAttribute('data-active', id === 'season-2' ? '2' : '1');

						if (updateHash) {
							var nextHash = id === 'season-2' ? '#season-2' : '';
							if (location.hash !== nextHash) {
								history.pushState(null, '', nextHash || location.pathname + location.search);
							}
						}

						if (fromClick) {
							var top = root.getBoundingClientRect().top + window.scrollY - 88;
							if (window.scrollY > top + 8) {
								window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
							}
						}

						window.dispatchEvent(new Event('resize'));
					}

					tabs.forEach(function (tab, index) {
						tab.addEventListener('click', function () {
							select(tab.id.replace('tab-', ''), { fromClick: true });
							tab.focus();
						});

						tab.addEventListener('keydown', function (event) {
							var next = index;
							if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
							else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
							else if (event.key === 'Home') next = 0;
							else if (event.key === 'End') next = tabs.length - 1;
							else return;

							event.preventDefault();
							var target = tabs[next];
							select(target.id.replace('tab-', ''), { fromClick: true });
							target.focus();
						});
					});

					window.addEventListener('popstate', function () {
						select(idFromHash(), { updateHash: false });
					});

					select(idFromHash(), { updateHash: false });
				})();
			</script>
