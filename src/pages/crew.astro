---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CrewMemberModal from '../components/crew/CrewMemberModal.astro';
import OrgBranch from '../components/crew/OrgBranch.astro';
import { crewMembers, getCrewTree, getTreeDepth, getWidestGroup } from '../data/crew';
import { getPage, pageTitle } from '../data/site';
import '../styles/pages/crew.css';

const page = getPage('/crew');
const crewTree = getCrewTree(crewMembers);
---

<BaseLayout title={pageTitle(page.heading)} description="Meet the RN Racing crew.">
	<main>
		<PageHeader title={page.heading} />

		<div
			class="org-chart"
			style={`--depth-base: ${getTreeDepth(crewTree, false)}; --depth-full: ${getTreeDepth(crewTree)}; --org-cols: ${getWidestGroup(crewTree)};`}
		>
			<OrgBranch nodes={crewTree} />
		</div>
	</main>

	<CrewMemberModal members={crewMembers} />
</BaseLayout>

<script>
	// Secret members are hidden until "n" is pressed (same key as the timeline's racing cars).
	const chart = document.querySelector<HTMLElement>('.org-chart');

	function isTypingTarget(el: EventTarget | null) {
		if (!(el instanceof HTMLElement)) return false;
		const tag = el.tagName;
		return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el.isContentEditable;
	}

	window.addEventListener('keydown', (event) => {
		if (!chart || (event.key !== 'n' && event.key !== 'N')) return;
		if (event.metaKey || event.ctrlKey || event.altKey) return;
		if (isTypingTarget(event.target)) return;
		event.preventDefault();
		chart.toggleAttribute('data-show-secret');
	});
</script>
