---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CrewMemberModal from '../components/crew/CrewMemberModal.astro';
import OrgBranch from '../components/crew/OrgBranch.astro';
import { crewMembers, getCrewTree, getTreeDepth, getWidestGroup } from '../data/crew';
import { getPage, pageTitle } from '../data/site';
import '../styles/pages/crew.css';

const page = getPage('/crew');
const crewTree = getCrewTree(crewMembers);
---

<BaseLayout title={pageTitle(page.heading)} description="Meet the RN Racing crew.">
	<main>
		<PageHeader title={page.heading} />

		<div class="org-chart" style={`--org-depth: ${getTreeDepth(crewTree)}; --org-cols: ${getWidestGroup(crewTree)};`}>
			<OrgBranch nodes={crewTree} />
		</div>
	</main>

	<CrewMemberModal members={crewMembers} />
</BaseLayout>
