---
import BaseLayout from '../layouts/BaseLayout.astro';

const teamMembers = [
	{ name: 'Vamsi', title: 'Co-Founder' },
	{ name: 'Rohith', title: 'Co-Founder' },
	{ name: 'Kamran', title: 'Human Resources' },
	{ name: 'Nyle', title: 'CEO and Team Captain' },
	{ name: 'Danial', title: 'Lead Chirp Engineer' },
	{ name: 'Varoon', title: 'Immigration Lawyer' },
	{ name: 'Vasu', title: 'Section 8 Garage Supervisor' },
	{ name: 'Sid', title: "Kamran's Intern" },
	{ name: 'Baggy', title: 'Lead Ragebaiter' },
];
---

<BaseLayout
	title="The Team — RN Racing"
	description="Meet the RN Racing team."
>
	<main>
		<header class="page-header">
			<p class="eyebrow">Crew</p>
			<h1>The Team</h1>
			<p class="lead">The people behind RN Racing.</p>
		</header>

		<ul class="team-grid">
			{
				teamMembers.map((member) => (
					<li class="team-card">
						<div class="photo-placeholder" aria-hidden="true">
							<span class="photo-icon">RN</span>
						</div>
						<div class="member-info">
							<h2>{member.name}</h2>
							<p>{member.title}</p>
						</div>
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>

<style>
	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.team-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.member-info {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.photo-placeholder {
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background:
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--surface) 88%, var(--muted)) 0%,
				var(--surface) 100%
			);
	}

	.photo-icon {
		font-family: var(--font-display);
		font-size: 1.5rem;
		line-height: var(--display-line);
		padding-bottom: var(--display-descender);
		color: color-mix(in srgb, var(--muted) 70%, transparent);
	}

	.member-info h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.5rem;
		line-height: var(--display-line-heading);
		padding-bottom: var(--display-descender);
	}

	.member-info p {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--muted);
	}
</style>
