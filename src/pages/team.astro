---
import BaseLayout from '../layouts/BaseLayout.astro';

const placeholderBio =
	'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.';

const teamMembers = [
	{ name: 'Vamsi', title: 'Co-Founder', bio: placeholderBio },
	{ name: 'Rohith', title: 'Co-Founder', bio: placeholderBio },
	{ name: 'Kamran', title: 'Human Resources', bio: placeholderBio },
	{ name: 'Nyle', title: 'CEO and Team Captain', bio: placeholderBio },
	{ name: 'Danial', title: 'Lead Chirp Engineer', bio: placeholderBio },
	{ name: 'Varoon', title: 'Immigration Lawyer', bio: placeholderBio },
	{ name: 'Vasu', title: 'Section 8 Garage Supervisor', bio: placeholderBio },
	{ name: 'Sid', title: "Kamran's Intern", bio: placeholderBio },
	{ name: 'Baggy', title: 'Lead Ragebaiter', bio: placeholderBio },
];
---

<BaseLayout
	title="The Crew — RN Racing"
	description="Meet the RN Racing team."
>
	<main>
		<header class="page-header">
			<h1>The Crew</h1>
		</header>

		<ul class="team-grid">
			{
				teamMembers.map((member, index) => (
					<li class="team-card">
						<button
							type="button"
							class="photo-trigger"
							data-member-index={index}
							aria-haspopup="dialog"
							aria-label={`View profile for ${member.name}`}
						>
							<span class="photo-placeholder">
								<span class="photo-icon">{member.name.slice(0, 2).toUpperCase()}</span>
							</span>
						</button>
						<div class="member-info">
							<h2>{member.name}</h2>
							<p>{member.title}</p>
						</div>
					</li>
				))
			}
		</ul>
	</main>

	<div class="member-modal" hidden>
		<div class="member-modal-backdrop" data-modal-close aria-hidden="true"></div>
		<div
			class="member-modal-panel"
			role="dialog"
			aria-modal="true"
			aria-labelledby="member-modal-name"
			tabindex="-1"
		>
			<button type="button" class="member-modal-close" data-modal-close aria-label="Close profile">
				<span aria-hidden="true">&times;</span>
			</button>

			<div class="member-modal-layout">
				<div class="member-modal-photo" aria-hidden="true">
					<span class="member-modal-photo-icon" id="member-modal-initials">RN</span>
				</div>
				<div class="member-modal-content">
					<h2 id="member-modal-name"></h2>
					<p class="member-modal-title" id="member-modal-title"></p>
					<p class="member-modal-bio" id="member-modal-bio"></p>
				</div>
			</div>
		</div>
	</div>

	<script id="team-members-data" type="application/json" set:html={JSON.stringify(teamMembers)} />

	<script>
		const members = JSON.parse(
			document.getElementById('team-members-data')?.textContent || '[]',
		) as Array<{ name: string; title: string; bio: string }>;

		const modal = document.querySelector('.member-modal') as HTMLDivElement | null;
		const panel = document.querySelector('.member-modal-panel') as HTMLDivElement | null;
		const nameEl = document.getElementById('member-modal-name');
		const titleEl = document.getElementById('member-modal-title');
		const bioEl = document.getElementById('member-modal-bio');
		const initialsEl = document.getElementById('member-modal-initials');
		const triggers = document.querySelectorAll<HTMLButtonElement>('.photo-trigger');
		const closeTargets = document.querySelectorAll('[data-modal-close]');

		let lastFocused: HTMLElement | null = null;

		const openModal = (index: number) => {
			const member = members[index];
			if (!member || !modal || !panel || !nameEl || !titleEl || !bioEl || !initialsEl) return;

			lastFocused = document.activeElement as HTMLElement | null;
			nameEl.textContent = member.name;
			titleEl.textContent = member.title;
			bioEl.textContent = member.bio;
			initialsEl.textContent = member.name.slice(0, 2).toUpperCase();

			modal.hidden = false;
			document.body.classList.add('modal-open');
			panel.focus();
		};

		const closeModal = () => {
			if (!modal) return;
			modal.hidden = true;
			document.body.classList.remove('modal-open');
			lastFocused?.focus();
		};

		triggers.forEach((trigger) => {
			trigger.addEventListener('click', () => {
				const index = Number(trigger.dataset.memberIndex);
				openModal(index);
			});
		});

		closeTargets.forEach((target) => {
			target.addEventListener('click', closeModal);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && modal && !modal.hidden) {
				closeModal();
			}
		});
	</script>
</BaseLayout>

<style>
	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.team-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.member-info {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.photo-trigger {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		text-align: left;
	}

	.photo-trigger:hover .photo-placeholder,
	.photo-trigger:focus-visible .photo-placeholder {
		border-color: color-mix(in srgb, var(--blue) 45%, var(--border));
		background:
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--surface) 70%, var(--blue)) 0%,
				var(--surface) 100%
			);
	}

	.photo-trigger:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 3px;
		border-radius: 0.5rem;
	}

	.photo-placeholder {
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background:
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--surface) 88%, var(--muted)) 0%,
				var(--surface) 100%
			);
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			transform 0.15s ease;
	}

	.photo-trigger:hover .photo-placeholder {
		transform: translateY(-2px);
	}

	.photo-icon {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 600;
		line-height: var(--display-line);
		padding-bottom: var(--display-descender);
		color: color-mix(in srgb, var(--muted) 70%, transparent);
	}

	.member-info h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 600;
		line-height: var(--display-line-heading);
		padding-bottom: var(--display-descender);
	}

	.member-info p {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.member-modal {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-items: center;
		padding: 1.5rem;
	}

	.member-modal[hidden] {
		display: none;
	}

	.member-modal-backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--black) 55%, transparent);
		backdrop-filter: blur(8px);
	}

	.member-modal-panel {
		position: relative;
		width: min(100%, 56rem);
		max-height: min(90dvh, 40rem);
		overflow: auto;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 0.875rem;
		background: var(--surface);
		box-shadow: 0 24px 64px color-mix(in srgb, var(--black) 35%, transparent);
	}

	.member-modal-close {
		position: absolute;
		top: 0.875rem;
		right: 0.875rem;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg);
		color: var(--muted);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.member-modal-close:hover {
		color: var(--text);
		border-color: color-mix(in srgb, var(--blue) 35%, var(--border));
	}

	.member-modal-layout {
		display: grid;
		grid-template-columns: minmax(12rem, 18rem) 1fr;
		gap: 2rem;
		align-items: start;
	}

	.member-modal-photo {
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background:
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--surface) 70%, var(--blue)) 0%,
				var(--bg) 100%
			);
	}

	.member-modal-photo-icon {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 8vw, 4rem);
		font-weight: 600;
		line-height: var(--display-line-heading);
		color: color-mix(in srgb, var(--muted) 75%, var(--text));
	}

	.member-modal-content h2 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 5vw, 2.75rem);
	}

	.member-modal-title {
		margin: 0 0 1.25rem;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--blue);
	}

	.member-modal-bio {
		margin: 0;
		font-size: 1.0625rem;
		line-height: 1.75;
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.member-modal {
			padding: 1rem;
		}

		.member-modal-panel {
			padding: 1.25rem;
		}

		.member-modal-layout {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.member-modal-photo {
			max-width: 14rem;
			margin: 0 auto;
			width: 100%;
		}
	}
</style>

<style is:global>
	body.modal-open {
		overflow: hidden;
	}
</style>
