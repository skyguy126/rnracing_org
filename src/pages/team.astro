---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import TeamMemberModal from '../components/TeamMemberModal.astro';
import { getInitials, teamMembers } from '../data/team';
---

<BaseLayout title="The Crew — RN Racing" description="Meet the RN Racing team.">
	<main>
		<PageHeader title="The Crew" />

		<ul class="team-grid">
			{
				teamMembers.map((member, index) => (
					<li class="team-card">
						<button
							type="button"
							class="photo-trigger"
							data-member-index={index}
							aria-haspopup="dialog"
							aria-label={`View profile for ${member.name}`}
						>
							<PhotoPlaceholder initials={getInitials(member.name)} />
						</button>
						<div class="member-info">
							<h2>{member.name}</h2>
							<p>{member.title}</p>
						</div>
					</li>
				))
			}
		</ul>
	</main>

	<TeamMemberModal members={teamMembers} />
</BaseLayout>

<style>
	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.team-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.member-info {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.photo-trigger {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		text-align: left;
	}

	.photo-trigger:hover :global(.photo-placeholder),
	.photo-trigger:focus-visible :global(.photo-placeholder) {
		border-color: color-mix(in srgb, var(--blue) 45%, var(--border));
		background:
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--surface) 70%, var(--blue)) 0%,
				var(--surface) 100%
			);
		transform: translateY(-2px);
	}

	.photo-trigger:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 3px;
		border-radius: 0.5rem;
	}

	.member-info h2 {
		margin: 0;
		font-size: 1.75rem;
	}

	.member-info p {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--muted);
	}
</style>
