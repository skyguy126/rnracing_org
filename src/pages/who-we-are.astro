---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ActionCard from '../components/ActionCard.astro';
import CopyEmailButton from '../components/CopyEmailButton.astro';
import { getPage, pageTitle, SITE } from '../data/site';

const page = getPage('/who-we-are');
---

<BaseLayout
	title={pageTitle(page.heading)}
	description="Who we are — contribute to RN Racing and get in touch."
>
	<PageHeader title={page.heading}>
		<Fragment slot="lead">
			We're a California-based endurance racing team with questionable judgement, competing with a
			'96 Camry in{' '}
			<a href="https://24hoursoflemons.com/" target="_blank" rel="noopener noreferrer">
				24 hours of Lemons
			</a>
			{' '}as #711. Amongst other things. Don't ask about the other things.
		</Fragment>
	</PageHeader>

	<section class="action-grid" aria-label="Contribute and contact">
		<ActionCard
			title="Contribute"
			description="We take PRs more seriously than Venmo — for now. The firmware is open, break something useful."
		>
			<a class="btn-primary" href={SITE.github} target="_blank" rel="noopener noreferrer">
				Open GitHub
			</a>
		</ActionCard>

		<ActionCard
			title="Contact"
			description="For partnerships, media, or general inquiries, please DO NOT reach out. We're busy, we have a car to build."
		>
			<CopyEmailButton email={SITE.email} />
		</ActionCard>

		<ActionCard
			title="Instagram"
			description="Follow @_rnracing_ for race updates, behind-the-scenes content, and team news. And Varoon's horrible humor."
		>
			<a class="btn-primary" href={SITE.instagram} target="_blank" rel="noopener noreferrer">
				Visit Instagram
			</a>
		</ActionCard>
	</section>
</BaseLayout>
