---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ActionCard from '../components/ActionCard.astro';
import CopyEmailButton from '../components/CopyEmailButton.astro';
import { getPage, pageTitle, SITE } from '../data/site';

const page = getPage('/who-we-are');
---

<BaseLayout
	title={pageTitle(page.heading)}
	description="Who we are — get in touch with RN Racing."
>
	<PageHeader title={page.heading} wide>
		<Fragment slot="lead">
			<p>
				We're a California-based endurance racing team with questionable judgement, driving a
				'96 Camry that we've upgraded ourselves into a Fruit Ninja themed race car, despite not
				a single one of us being a professional car mechanic. Come drive our shitbox, it's totally safe.
			</p>
			<p>
				We compete as car #711 in{' '}
				<a href="https://24hoursoflemons.com/" target="_blank" rel="noopener noreferrer">
					24 hours of Lemons
				</a>{' '}
				, a series for $500 cars. We've participated in the Sonoma 2025 and Buttonwillow 2026 races, 
				inexplicably winning the{' '}
				<a href="https://24hoursoflemons.com/results-2/?id=454" target="_blank" rel="noopener noreferrer">
					Halloween Meets Gasoline prize 
				</a>
				{' '} at the latter. If you want to see our next race, come watch us at Thunderhill Raceway park
				from May 29 to May 30 2027. It's 50/50 on whether we finish the race or spectacularly
				spin out on the track.
			</p>
			<p>
				We're all also huge dog lovers (probably because we're dawgs ourselves) and we've partnered with{' '}
				<a href="https://rosiesheroes.org/" target="_blank" rel="noopener noreferrer">
					Rosie's Heroes
				</a>, a 501(c)(3) animal rescue helping street dogs in India. At Buttonwillow 2026, we raised
				and donated almost $4k through our Fruit Ninja fruit stand. If you would like to contribute,
				please check out the Rosie's website or look up Rosie's Broken to Braves Heroes on Benevity!
			</p>
		</Fragment>
	</PageHeader>

	<section class="action-grid" aria-label="Contact and social">
		<ActionCard
			title="Contact"
			description="For partnerships, media, or general inquiries, please DO NOT reach out. We're busy, we have a car to build."
		>
			<CopyEmailButton email={SITE.email} />
		</ActionCard>

		<ActionCard
			title="Instagram"
			description="Follow @_rnracing_ for race updates, behind-the-scenes content, and team news. And Varoon's horrible humor."
		>
			<a class="btn-primary" href={SITE.instagram} target="_blank" rel="noopener noreferrer">
				Visit Instagram
			</a>
		</ActionCard>

		<ActionCard
			title="YouTube"
			description="Crash footage, garage fight club, and an expanding archive of decisions that seemed fine at the time."
		>
			<a class="btn-primary" href={SITE.youtube} target="_blank" rel="noopener noreferrer">
				Watch YouTube
			</a>
		</ActionCard>
	</section>
</BaseLayout>
