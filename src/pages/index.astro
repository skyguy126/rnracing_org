---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<main>
		<header>
			<p class="eyebrow">Motorsport</p>
			<h1>RN Racing</h1>
			<p class="lead">
				Official home of RN Racing. Updates, results, and media coming soon.
			</p>
		</header>

		<section class="links" aria-label="Social links">
			<a
				class="link-card"
				href="https://www.instagram.com/_rnracing_/"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="link-label">Instagram</span>
				<span class="link-handle">@_rnracing_</span>
			</a>
		</section>
	</main>
</BaseLayout>

<style>
	header {
		margin-bottom: 3rem;
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.5rem, 8vw, 4rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.lead {
		margin: 0;
		max-width: 32ch;
		font-size: 1.125rem;
		color: var(--muted);
	}

	.links {
		display: grid;
		gap: 1rem;
	}

	.link-card {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background: var(--surface);
		text-decoration: none;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.link-card:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
		text-decoration: none;
	}

	.link-label {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.link-handle {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--text);
	}
</style>
