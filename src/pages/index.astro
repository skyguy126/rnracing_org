---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { STORY } from '../data/site';
---

<BaseLayout>
	<main>
		<PageHeader
			title="RN Racing"
			lead="Official home of RN Racing. Updates, results, and media coming soon."
		/>

		<section class="content-section" aria-labelledby="story-heading">
			<h2 id="story-heading">The Story</h2>
			{STORY.map((paragraph) => <p>{paragraph}</p>)}
		</section>
	</main>
</BaseLayout>
