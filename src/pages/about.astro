---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ActionCard from '../components/ActionCard.astro';
import CopyEmailButton from '../components/CopyEmailButton.astro';
import { SITE } from '../data/site';
---

<BaseLayout
	title="Who We Are — RN Racing"
	description="Who we are — support RN Racing and get in touch."
>
	<main>
		<PageHeader
			title="Who We Are"
			lead="RN Racing is a motorsport team building something worth following. More updates coming soon."
		/>

		<section class="action-grid" aria-label="Support and contact">
			<ActionCard
				title="Support the team"
				description="Help fuel the next race weekend. Donations are not live yet — this is a preview."
			>
				<button type="button" class="btn-primary">Donate</button>
			</ActionCard>

			<ActionCard
				title="Contact"
				description="For partnerships, media, or general inquiries, reach out anytime."
			>
				<CopyEmailButton email={SITE.email} />
			</ActionCard>

			<ActionCard
				title="Instagram"
				description="Follow @_rnracing_ for race updates, behind-the-scenes content, and team news."
			>
				<a class="btn-primary" href={SITE.instagram} target="_blank" rel="noopener noreferrer">
					Visit Instagram
				</a>
			</ActionCard>
		</section>
	</main>
</BaseLayout>
