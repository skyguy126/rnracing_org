---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Who We Are — RN Racing"
	description="Who we are — support RN Racing and get in touch."
>
	<main>
		<header class="page-header">
			<h1>Who We Are</h1>
			<p class="lead">
				RN Racing is a motorsport team building something worth following. More updates
				coming soon.
			</p>
		</header>

		<section class="about-actions" aria-label="Support and contact">
			<div class="action-card">
				<h2>Support the team</h2>
				<p>Help fuel the next race weekend. Donations are not live yet — this is a preview.</p>
				<button type="button" class="donate-button">Donate</button>
			</div>

			<div class="action-card">
				<h2>Contact</h2>
				<p>For partnerships, media, or general inquiries, reach out anytime.</p>
				<a class="contact-link" href="mailto:hello@rnracing.org">hello@rnracing.org</a>
			</div>

			<div class="action-card">
				<h2>Instagram</h2>
				<p>Follow @_rnracing_ for race updates, behind-the-scenes content, and team news.</p>
				<a
					class="donate-button"
					href="https://www.instagram.com/_rnracing_/"
					target="_blank"
					rel="noopener noreferrer"
				>
					Visit Instagram
				</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.about-actions {
		max-width: var(--content-max-width);
		display: grid;
		gap: 1rem;
	}

	.action-card h2 {
		margin: 0 0 1rem;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
	}

	.action-card {
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 0.625rem;
		background: color-mix(in srgb, var(--surface) 80%, transparent);
	}

	.action-card p {
		margin: 0 0 1.25rem;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--muted);
	}

	.donate-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 8rem;
		padding: 0.75rem 1.5rem;
		border: 0;
		border-radius: 999px;
		background: var(--blue);
		color: var(--white);
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		cursor: pointer;
		transition: background-color 0.15s ease, transform 0.15s ease;
	}

	.donate-button:hover {
		background: var(--blue-soft);
		color: var(--white);
		transform: translateY(-1px);
	}

	.contact-link {
		display: inline-flex;
		align-items: center;
		font-size: 1.0625rem;
		font-weight: 600;
	}

	@media (min-width: 640px) {
		.about-actions {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 960px) {
		.about-actions {
			max-width: var(--layout-max-width);
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
