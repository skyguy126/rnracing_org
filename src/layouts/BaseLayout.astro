---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	fullWidth?: boolean;
}

const {
	title = SITE.name,
	description = SITE.description,
	fullWidth = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" style="color-scheme: dark">
	<head>
		<meta charset="utf-8" />
		<meta name="theme-color" content="#09090b" />
		<meta name="color-scheme" content="dark" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<link rel="icon" type="image/png" href="/rn-racing-logo.png" />
		<link rel="apple-touch-icon" href="/rn-racing-logo.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Caveat:wght@500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<NavBar />
		{fullWidth ? <slot /> : <main class="layout-inner"><slot /></main>}
		<Footer />
	</body>
</html>
