---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'RN Racing',
	description = 'RN Racing — motorsport team. More coming soon.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				var match = document.cookie.match(/(?:^|; )rnracing-theme=([^;]*)/);
				var theme = match ? decodeURIComponent(match[1]) : 'dark';
				document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Gloria+Hallelujah&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<NavBar />
		<slot />
		<footer>
			<p>&copy; {new Date().getFullYear()} RN Racing</p>
		</footer>
	</body>
</html>
