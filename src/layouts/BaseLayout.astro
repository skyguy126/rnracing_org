---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	fullWidth?: boolean;
}

const {
	title = SITE.name,
	description = SITE.description,
	fullWidth = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<script is:inline define:vars={{ cookieName: 'rnracing-theme' }}>
			(function () {
				var match = document.cookie.match(new RegExp('(?:^|; )' + cookieName + '=([^;]*)'));
				var theme = match ? decodeURIComponent(match[1]) : 'light';
				document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Caveat:wght@500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<NavBar />
		{fullWidth ? <slot /> : <main><slot /></main>}
		<Footer />
	</body>
</html>
