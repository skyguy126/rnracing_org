	function resizeSwipeCanvas() {
		if (!swipeCtx) return;
		const dpr = Math.max(1, window.devicePixelRatio || 1);
		const { w, h } = size();
		swipeCanvas.width = Math.max(1, Math.floor(w * dpr));
		swipeCanvas.height = Math.max(1, Math.floor(h * dpr));
		swipeCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
	}

	function prunePointerSamples(nowMs: number) {
		const cutoff = nowMs - GAME.trailHistoryMs;
		while (pointerSamples.length && pointerSamples[0]!.time < cutoff) {
			pointerSamples.shift();
		}
	}

	function drawSwipeTrail(nowMs: number) {
		if (!swipeCtx) return;
		const { w, h } = size();
		swipeCtx.clearRect(0, 0, w, h);
		prunePointerSamples(nowMs);
		if (pointerSamples.length < 2) return;

		swipeCtx.save();
		swipeCtx.lineCap = 'round';
		swipeCtx.lineJoin = 'round';
		swipeCtx.globalCompositeOperation = 'lighter';

		for (let i = 1; i < pointerSamples.length; i++) {
			const a = pointerSamples[i - 1]!;
			const b = pointerSamples[i]!;
			const segLen = dist(a.x, a.y, b.x, b.y);
			const segDt = Math.max(0.001, (b.time - a.time) / 1000);
			const speed = segLen / segDt;
			const age = (nowMs - b.time) / GAME.trailHistoryMs;
			const alpha = clamp(1 - age, 0, 1);
			const width = clamp(lerp(5, 12, clamp((speed - 200) / 1200, 0, 1)), 4, 14);

			swipeCtx.beginPath();
			swipeCtx.moveTo(a.x, a.y);
			swipeCtx.lineTo(b.x, b.y);
			swipeCtx.strokeStyle = `rgba(120, 190, 255, ${0.22 * alpha})`;
			swipeCtx.lineWidth = width + 5;
			swipeCtx.stroke();

			swipeCtx.beginPath();
			swipeCtx.moveTo(a.x, a.y);
			swipeCtx.lineTo(b.x, b.y);
			swipeCtx.strokeStyle = `rgba(255, 255, 255, ${0.92 * alpha})`;
			swipeCtx.lineWidth = width;
			swipeCtx.stroke();
		}

		swipeCtx.restore();
	}

	function ensureTrailLoop() {
		if (trailRafId) return;
		const loop = (now: number) => {
			drawSwipeTrail(now);
			if (pointerSamples.length > 0 || pointerDown) {
				trailRafId = window.requestAnimationFrame(loop);
			} else {
				trailRafId = 0;
				if (swipeCtx) {
					const { w, h } = size();
					swipeCtx.clearRect(0, 0, w, h);
				}
			}
		};
		trailRafId = window.requestAnimationFrame(loop);
	}

	function stagePointFromEvent(e: PointerEvent): Vec {
		const rect = stage.getBoundingClientRect();
		return { x: e.clientX - rect.left, y: e.clientY - rect.top };
	}

	function pushPointerSample(x: number, y: number, time: number) {
		pointerSamples.push({ x, y, time });
		prunePointerSamples(time);
		ensureTrailLoop();
	}

	function launchRevealLemon() {
		const { w, h } = size();
		const cutX = w * 0.5 + (w < 640 ? 10 : 20);
		const cutY = h * 0.36;
		const startX = w * 0.24;
		const startY = h + 110;
		const flight = T.slice - T.lemonLaunch;
		const vx = (cutX - startX) / flight;
		const vy = (cutY - startY) / flight - 0.5 * GRAVITY * flight;

		lemon = {
			x: startX,
			y: startY,
			vx,
			vy,
			rotation: -20,
			angularVelocity: 220,
			visible: true,
		};
		lemonLaunched = true;
		sliced = false;
		fruitRoundActive = true;
		lemonWhole.style.opacity = '1';
		lemonWhole.style.visibility = 'visible';
		halfA.style.visibility = 'hidden';
		halfB.style.visibility = 'hidden';
		halfA.style.opacity = '0';
		halfB.style.opacity = '0';
		syncFruitFromLemon();
	}

	function spawnX() {
		const { w } = size();
		const mobile = isMobileLayout();
		const minFrac = mobile ? 0.14 : 0.18;
		const maxFrac = mobile ? 0.86 : 0.82;
		const logoW = logo.getBoundingClientRect().width || w * 0.4;
		const center = w * 0.5;
		const halfLogo = logoW * 0.38;
		// Bias away from the logo core so arcs stay sliceable.
		const side = Math.random() < 0.5 ? -1 : 1;
		const minOff = halfLogo * 0.45;
		const maxOff = Math.min(w * (mobile ? 0.34 : 0.3), halfLogo + w * 0.14);
		const offset = rand(minOff, maxOff) * side;
		return clamp(center + offset, w * minFrac, w * maxFrac);
	}

	function spawnXs(count: number) {
		const { w } = size();
		const mobile = isMobileLayout();
		const minFrac = mobile ? 0.14 : 0.18;
		const maxFrac = mobile ? 0.86 : 0.82;
		const minX = w * minFrac;
		const maxX = w * maxFrac;
		if (count <= 1) return [spawnX()];

		const xs: number[] = [];
		const minSep = w * (mobile ? 0.16 : 0.14);
		for (let i = 0; i < count; i++) {
			let x = spawnX();
			let attempts = 0;
			while (attempts < 8 && xs.some((other) => Math.abs(other - x) < minSep)) {
				x = lerp(minX, maxX, (i + 0.5) / count + rand(-0.08, 0.08));
				x = clamp(x, minX, maxX);
				attempts++;
			}
			xs.push(x);
		}
		return xs;
	}

	function pickWaveCount() {
		const r = Math.random();
		if (r < 0.52) return 1;
		if (r < 0.82) return 2;
		return 3;
	}

	function cloneFruitImg(source: HTMLImageElement, parent: HTMLElement) {
		const el = source.cloneNode(true) as HTMLImageElement;
		el.removeAttribute('id');
		el.style.opacity = '0';
		el.style.visibility = 'hidden';
		parent.appendChild(el);
		return el;
	}

	function showFx(el: HTMLImageElement, opacity = '1') {
		el.style.visibility = 'visible';
		el.style.opacity = opacity;
