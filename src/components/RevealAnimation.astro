	function renderHalves() {
		const a = halfAlign('a');
		const b = halfAlign('b');
		setTransform(halfA, halfAState.x + a.x, halfAState.y + a.y, halfAState.rotation, 1);
		setTransform(halfB, halfBState.x + b.x, halfBState.y + b.y, halfBState.rotation, 1);
	}

	function renderScoreDigits(value: number, pop = false) {
		const text = String(Math.max(0, Math.floor(value)));
		scoreDigitsEl.replaceChildren();
		for (const ch of text) {
			const idx = ch.charCodeAt(0) - 48;
			if (idx < 0 || idx > 9) continue;
			const img = document.createElement('img');
			img.className = 'reveal-score__digit';
			img.src = SCORE_DIGIT_SRCS[idx];
			img.alt = '';
			img.draggable = false;
			img.setAttribute('aria-hidden', 'true');
			scoreDigitsEl.appendChild(img);
		}
		scoreEl.setAttribute('aria-label', `Score ${text}`);
		if (pop) {
			scoreDigitsEl.classList.remove('is-pop');
			// Force reflow so the pop animation can replay.
			void scoreDigitsEl.offsetWidth;
			scoreDigitsEl.classList.add('is-pop');
		}
	}

	function preloadScoreDigits() {
		for (const src of SCORE_DIGIT_SRCS) {
