	function blankGameFruit(els: {
		whole: HTMLImageElement;
		halfA: HTMLImageElement;
		halfB: HTMLImageElement;
		slash: HTMLImageElement;
		splash: HTMLImageElement;
		droplets: HTMLImageElement;
