---
const ASSETS = {
	background: '/reveal/background/wood_dojo_background.jpg',
	logo: '/reveal/brand/rn_logo_original.png',
	lemonWhole: '/reveal/lemons/lemons_logo_whole.png',
	lemonHalfA: '/reveal/lemons/lemons_logo_half_a.png',
	lemonHalfB: '/reveal/lemons/lemons_logo_half_b.png',
	slash: '/reveal/effects/blade_slash.png',
	splash: '/reveal/effects/juice_splash.png',
	droplets: '/reveal/effects/juice_droplets.png',
	comingSoon: '/reveal/text/coming_soon.png',
	scoreDigits: [
		'/reveal/ui/score_digits/0.png',
		'/reveal/ui/score_digits/1.png',
		'/reveal/ui/score_digits/2.png',
		'/reveal/ui/score_digits/3.png',
		'/reveal/ui/score_digits/4.png',
		'/reveal/ui/score_digits/5.png',
		'/reveal/ui/score_digits/6.png',
		'/reveal/ui/score_digits/7.png',
		'/reveal/ui/score_digits/8.png',
		'/reveal/ui/score_digits/9.png',
	],
} as const;

const PAINT_STROKES = [
	{ x: 18, y: 28, rx: 42, ry: 34, delay: 0.0, duration: 0.55, rotate: -18 },
	{ x: 72, y: 22, rx: 38, ry: 30, delay: 0.06, duration: 0.52, rotate: 22 },
	{ x: 48, y: 55, rx: 48, ry: 40, delay: 0.12, duration: 0.58, rotate: 8 },
	{ x: 12, y: 68, rx: 36, ry: 32, delay: 0.18, duration: 0.5, rotate: -28 },
	{ x: 86, y: 62, rx: 40, ry: 36, delay: 0.2, duration: 0.54, rotate: 16 },
	{ x: 38, y: 12, rx: 44, ry: 28, delay: 0.1, duration: 0.48, rotate: 4 },
	{ x: 58, y: 82, rx: 50, ry: 34, delay: 0.26, duration: 0.5, rotate: -10 },
	{ x: 50, y: 45, rx: 58, ry: 48, delay: 0.32, duration: 0.55, rotate: 0 },
] as const;
---

<p class="reveal-loading" id="reveal-loading" role="status">Loading...</p>
<div class="reveal-root" id="reveal-root">
<div class="reveal-stage" id="reveal-stage" aria-label="RN Racing teaser reveal" role="img">
	<div class="reveal-veil" id="reveal-veil" aria-hidden="true"></div>

	<div class="reveal-bg" aria-hidden="true">
		{
			PAINT_STROKES.map((stroke, i) => (
				<div
					class="reveal-bg__stroke"
					data-stroke={i}
					style={`--sx:${stroke.x}%; --sy:${stroke.y}%; --srx:0%; --sry:0%; --srot:${stroke.rotate}deg; background-image:url(${ASSETS.background})`}
				/>
			))
		}
		<div class="reveal-bg__full" id="reveal-bg-full" style={`background-image:url(${ASSETS.background})`}></div>
	</div>

	<div class="reveal-scene" id="reveal-scene">
		<img
			class="reveal-logo"
			id="reveal-logo"
			src={ASSETS.logo}
			alt="RN Racing"
			width="2046"
			height="1664"
			draggable="false"
		/>

		<div class="reveal-lemon-layer" id="reveal-lemon-layer" aria-hidden="true">
			<img
				class="reveal-lemon reveal-lemon--whole"
				id="reveal-lemon-whole"
				src={ASSETS.lemonWhole}
				alt=""
				width="1254"
				height="1254"
				draggable="false"
			/>
			<img
				class="reveal-lemon reveal-lemon--half"
				id="reveal-lemon-half-a"
				src={ASSETS.lemonHalfA}
				alt=""
				width="1254"
				height="1254"
				draggable="false"
			/>
			<img
				class="reveal-lemon reveal-lemon--half"
				id="reveal-lemon-half-b"
				src={ASSETS.lemonHalfB}
				alt=""
				width="1254"
				height="1254"
				draggable="false"
			/>
		</div>

		<img
			class="reveal-fx reveal-fx--slash"
			id="reveal-slash"
			src={ASSETS.slash}
			alt=""
			width="2172"
			height="724"
			draggable="false"
			aria-hidden="true"
		/>
		<img
			class="reveal-fx reveal-fx--splash"
			id="reveal-splash"
			src={ASSETS.splash}
			alt=""
			width="1448"
			height="1086"
			draggable="false"
			aria-hidden="true"
		/>
		<img
			class="reveal-fx reveal-fx--droplets"
			id="reveal-droplets"
			src={ASSETS.droplets}
			alt=""
			width="1448"
			height="1086"
			draggable="false"
			aria-hidden="true"
		/>

		<img
			class="reveal-coming-soon"
			id="reveal-coming-soon"
			src={ASSETS.comingSoon}
			alt="Coming soon"
			width="2172"
			height="724"
			draggable="false"
		/>
	</div>

	<canvas id="reveal-swipe-canvas" class="reveal-swipe-canvas" aria-hidden="true"></canvas>

	<div class="reveal-score" id="reveal-score" aria-live="polite" aria-label="Score 0">
		<div class="reveal-score__frame">
			<div class="reveal-score__bezel">
				<div class="reveal-score__screen">
					<div class="reveal-score__digits" id="reveal-score-digits" aria-hidden="true"></div>
				</div>
			</div>
		</div>
	</div>
</div>

<button
	type="button"
	class="reveal-sound"
	id="reveal-sound-toggle"
	aria-pressed="false"
	aria-label="Mute music"
>
	<span class="reveal-sound__frame">
		<span class="reveal-sound__bezel">
			<span class="reveal-sound__screen">
				<svg class="reveal-sound__icon reveal-sound__icon--on" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M3.5 9.25h3.1L11 5.4c.5-.36 1.2 0 1.2.6v12c0 .6-.7.96-1.2.6L6.6 14.75H3.5A1.25 1.25 0 0 1 2.25 13.5v-2.75A1.25 1.25 0 0 1 3.5 9.25Z"
					></path>
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						d="M15.2 9.1a3.6 3.6 0 0 1 0 5.8"
					></path>
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						d="M17.6 6.7a6.4 6.4 0 0 1 0 10.6"
					></path>
				</svg>
				<svg class="reveal-sound__icon reveal-sound__icon--off" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M3.5 9.25h3.1L11 5.4c.5-.36 1.2 0 1.2.6v12c0 .6-.7.96-1.2.6L6.6 14.75H3.5A1.25 1.25 0 0 1 2.25 13.5v-2.75A1.25 1.25 0 0 1 3.5 9.25Z"
					></path>
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						d="M16.2 9.4 20.4 14.6M20.4 9.4 16.2 14.6"
					></path>
				</svg>
			</span>
		</span>
	</span>
</button>
</div>

<style>
	.reveal-loading {
		position: fixed;
		inset: 0;
		z-index: 40;
		display: grid;
		place-items: center;
		margin: 0;
		font-family: 'Barlow Condensed', 'Barlow', sans-serif;
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--white) 30%, transparent);
		pointer-events: none;
		transition: opacity 1.05s ease;
	}

	.reveal-loading.is-done {
		opacity: 0;
	}

	.reveal-root {
		position: relative;
		min-height: 100dvh;
		background: #050505;
		opacity: 0;
		transition: opacity 1.05s ease;
	}

	.reveal-root.is-visible {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-root,
		.reveal-loading {
			transition: none;
		}
	}

	.reveal-stage {
		position: relative;
		z-index: 0;
		isolation: isolate;
		width: 100%;
		min-height: 100dvh;
		overflow: hidden;
		background: #050505;
		user-select: none;
		touch-action: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.reveal-stage.is-game-active {
			cursor: none;
		}
	}

	.reveal-veil {
		position: absolute;
		inset: 0;
		z-index: 5;
		background: #050505;
		opacity: 1;
		pointer-events: none;
		transition: none;
	}

	.reveal-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.reveal-bg__stroke,
	.reveal-bg__full {
		position: absolute;
		inset: 0;
		background-position: center;
		background-size: cover;
		background-repeat: no-repeat;
		will-change: clip-path, opacity;
	}

	.reveal-bg__stroke {
		clip-path: ellipse(var(--srx) var(--sry) at var(--sx) var(--sy));
		transform: rotate(var(--srot));
		transform-origin: var(--sx) var(--sy);
		opacity: 0.95;
	}

	.reveal-bg__full {
		opacity: 0;
	}

	.reveal-scene {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: grid;
		place-items: center;
		pointer-events: none;
	}

	.reveal-logo {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 1;
		width: min(52vw, 420px);
		height: auto;
		opacity: 0;
		transform: translate3d(-50%, -50%, 0) scale(0.18);
		transform-origin: center center;
		filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.45));
		will-change: transform, opacity;
	}

	.reveal-lemon-layer {
		position: absolute;
		inset: 0;
		z-index: 3;
		overflow: visible;
	}

	.reveal-lemon {
		position: absolute;
		left: 0;
		top: 0;
		width: min(22vw, 148px);
		height: auto;
		opacity: 0;
		transform: translate3d(-50%, -50%, 0);
		transform-origin: center center;
		filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.4));
		will-change: transform, opacity;
		pointer-events: none;
	}

	.reveal-lemon--half {
		visibility: hidden;
	}

	.reveal-fx {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 4;
		opacity: 0;
		transform: translate3d(-50%, -50%, 0);
		transform-origin: center center;
		pointer-events: none;
		will-change: transform, opacity;
	}

	.reveal-fx--slash {
		width: min(62vw, 380px);
		height: auto;
		filter: drop-shadow(0 0 14px rgba(255, 255, 255, 0.4));
	}

	.reveal-fx--splash {
		width: min(34vw, 200px);
		height: auto;
	}

	.reveal-fx--droplets {
		width: min(30vw, 170px);
		height: auto;
	}

	.reveal-coming-soon {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 2;
		width: min(72vw, 520px);
		height: auto;
		opacity: 0;
		transform: translate3d(-50%, -50%, 0);
		filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.4));
		will-change: transform, opacity;
	}

	.reveal-swipe-canvas {
		position: absolute;
		inset: 0;
		z-index: 6;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.reveal-score {
		position: absolute;
		z-index: 7;
		box-sizing: border-box;
		width: max-content;
		max-width: min(42vw, 220px);
		height: auto;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease-out;
	}

	.reveal-score.is-visible {
		opacity: 1;
	}

	.reveal-score__frame {
		box-sizing: border-box;
		width: max-content;
		height: auto;
		padding: 5px;
		border-radius: 14px;
		border: 2px solid rgba(24, 12, 5, 0.9);
		background: linear-gradient(145deg, #76451f, #4d2913 45%, #2f190d);
		box-shadow:
			0 5px 14px rgba(0, 0, 0, 0.45),
			inset 0 1px 1px rgba(255, 220, 165, 0.25),
			inset 0 -2px 4px rgba(20, 8, 2, 0.45);
	}

	.reveal-score__bezel {
		box-sizing: border-box;
		width: max-content;
		height: auto;
		padding: 3px;
		border-radius: 10px;
		border: 1px solid rgba(0, 0, 0, 0.8);
		background: #171514;
	}

	.reveal-score__screen {
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		width: max-content;
		min-width: 2.6em;
		height: auto;
		padding: 6px 12px;
		border-radius: 7px;
		background:
			radial-gradient(120% 90% at 50% 18%, rgba(255, 255, 255, 0.22), transparent 55%),
			linear-gradient(165deg, rgba(242, 235, 213, 0.96), rgba(201, 195, 178, 0.94));
		box-shadow:
			inset 0 2px 7px rgba(0, 0, 0, 0.22),
			inset 0 -1px 2px rgba(255, 255, 255, 0.38);
	}

	/* :global — digit <img>s are created in JS and lack Astro scoped attrs */
	.reveal-score :global(.reveal-score__digits) {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0;
		transform-origin: center center;
		filter: drop-shadow(0 1px 1px rgba(40, 18, 4, 0.35));
	}

	.reveal-score :global(.reveal-score__digits.is-pop) {
		animation: reveal-score-pop 145ms ease-out;
	}

	.reveal-score :global(.reveal-score__digit) {
		display: block;
		height: clamp(30px, 3.2vw, 42px);
		width: auto;
		user-select: none;
		object-fit: contain;
		pointer-events: none;
	}

	@keyframes reveal-score-pop {
		0% {
			transform: scale(1);
		}
		45% {
			transform: scale(1.08);
		}
		100% {
			transform: scale(1);
		}
	}

	.reveal-sound {
		position: absolute;
		z-index: 30;
		top: max(16px, env(safe-area-inset-top, 0px));
		left: max(clamp(16px, 1.8vw, 24px), env(safe-area-inset-left, 0px));
		right: auto;
		box-sizing: border-box;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #2c1810;
		cursor: pointer;
		pointer-events: none;
		user-select: none;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
	}

	.reveal-sound:focus {
		outline: none;
	}

	.reveal-sound:focus-visible {
		outline: 2px solid rgba(255, 220, 165, 0.9);
		outline-offset: 3px;
	}

	.reveal-sound__frame {
		box-sizing: border-box;
		display: block;
		padding: 5px;
		border-radius: 14px;
		border: 2px solid rgba(24, 12, 5, 0.9);
		background: linear-gradient(145deg, #76451f, #4d2913 45%, #2f190d);
		box-shadow:
			0 5px 14px rgba(0, 0, 0, 0.45),
			inset 0 1px 1px rgba(255, 220, 165, 0.25),
			inset 0 -2px 4px rgba(20, 8, 2, 0.45);
	}

	.reveal-sound__bezel {
		box-sizing: border-box;
		display: block;
		padding: 3px;
		border-radius: 10px;
		border: 1px solid rgba(0, 0, 0, 0.8);
		background: #171514;
	}

	.reveal-sound__screen {
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 6px;
		border-radius: 7px;
		background:
			radial-gradient(120% 90% at 50% 18%, rgba(255, 255, 255, 0.22), transparent 55%),
			linear-gradient(165deg, rgba(242, 235, 213, 0.96), rgba(201, 195, 178, 0.94));
		box-shadow:
			inset 0 2px 7px rgba(0, 0, 0, 0.22),
			inset 0 -1px 2px rgba(255, 255, 255, 0.38);
	}

	.reveal-root.is-visible .reveal-sound {
		pointer-events: auto;
	}

	.reveal-sound__icon {
		display: block;
		width: clamp(30px, 3.2vw, 42px);
		height: clamp(30px, 3.2vw, 42px);
	}

	.reveal-sound__icon--off {
		display: none;
	}

	.reveal-sound.is-muted .reveal-sound__icon--on {
		display: none;
	}

	.reveal-sound.is-muted .reveal-sound__icon--off {
		display: block;
	}

	.reveal-sound:active .reveal-sound__frame {
		transform: translateY(1px);
	}

	@media (hover: hover) and (pointer: fine) {
		.reveal-sound:hover .reveal-sound__screen {
			filter: brightness(1.05);
		}
	}

	/* Desktop / tablet: compact top-right framed HUD */
	@media (min-width: 641px) {
		.reveal-score {
			top: max(16px, env(safe-area-inset-top, 0px));
			right: clamp(16px, 1.8vw, 24px);
			left: auto;
			bottom: auto;
		}
	}

	/* Mobile: compact centered framed unit (not a full-width strip) */
	@media (max-width: 640px) {
		.reveal-score {
			top: calc(8px + env(safe-area-inset-top, 0px));
			left: 50%;
			right: auto;
			bottom: auto;
			max-width: min(46vw, 180px);
			transform: translateX(-50%);
		}

		.reveal-score__frame {
			padding: 4px;
			border-radius: 12px;
		}

		.reveal-score__bezel {
			padding: 3px;
			border-radius: 9px;
		}

		.reveal-score__screen {
			padding: 5px 10px;
			border-radius: 6px;
			min-width: 2.4em;
		}

		.reveal-score :global(.reveal-score__digit) {
			height: clamp(28px, 7.5vw, 36px);
		}

		.reveal-sound {
			top: calc(8px + env(safe-area-inset-top, 0px));
			left: max(10px, env(safe-area-inset-left, 0px));
		}

		.reveal-sound__frame {
			padding: 4px;
			border-radius: 12px;
		}

		.reveal-sound__bezel {
			padding: 3px;
			border-radius: 9px;
		}

		.reveal-sound__screen {
			padding: 5px;
			border-radius: 6px;
		}

		.reveal-sound__icon {
			width: clamp(28px, 7.5vw, 36px);
			height: clamp(28px, 7.5vw, 36px);
		}

		.reveal-logo {
			width: min(68vw, 300px);
		}

		.reveal-lemon {
			width: min(30vw, 128px);
		}

		.reveal-fx--slash {
			width: min(78vw, 300px);
		}

		.reveal-fx--splash {
			width: min(42vw, 170px);
		}

		.reveal-fx--droplets {
			width: min(38vw, 150px);
		}

		.reveal-coming-soon {
			width: min(86vw, 420px);
		}
	}

	@media (min-width: 1100px) {
		.reveal-logo {
			width: min(40vw, 460px);
		}

		.reveal-lemon {
			width: min(16vw, 160px);
		}
	}
</style>

<script>
	type Vec = { x: number; y: number };

	type Projectile = {
		x: number;
		y: number;
		vx: number;
		vy: number;
		rotation: number;
		angularVelocity: number;
		visible: boolean;
	};

	type FruitState = {
		active: boolean;
		sliced: boolean;
		x: number;
		y: number;
		vx: number;
		vy: number;
		rotation: number;
		angularVelocity: number;
	};

	type Phase = 'reveal' | 'game';

	type PointerSample = { x: number; y: number; time: number };

	const PAINT = [
		{ rx: 42, ry: 34, delay: 0.0, duration: 0.55 },
		{ rx: 38, ry: 30, delay: 0.06, duration: 0.52 },
		{ rx: 48, ry: 40, delay: 0.12, duration: 0.58 },
		{ rx: 36, ry: 32, delay: 0.18, duration: 0.5 },
		{ rx: 40, ry: 36, delay: 0.2, duration: 0.54 },
		{ rx: 44, ry: 28, delay: 0.1, duration: 0.48 },
		{ rx: 50, ry: 34, delay: 0.26, duration: 0.5 },
		{ rx: 58, ry: 48, delay: 0.32, duration: 0.55 },
	] as const;

	/** Initial reveal timeline (seconds from start). */
	const T = {
		paintStart: 0.15,
		paintDone: 0.9,
		logoStart: 0.9,
		logoSettle: 1.7,
		lemonLaunch: 1.9,
		slice: 2.7,
		slashEnd: 2.84,
		splashEnd: 3.2,
		comingStart: 3.9,
		comingEnd: 4.5,
		gameStart: 5.1,
	} as const;

	const SONG_URL = 'https://media.munixnet.org/rnracing/vision.mp3';
	/** Playback position when the intro lemon reaches the blade. */
	const SONG_AT_SLICE = 52;

	const GRAVITY = 2400;
	const MAX_DT = 1 / 30;
	const LEMON_ASSET = 1254;
	/** Alpha-centroid offsets vs canvas center (source px) for slice alignment. */
	const WHOLE_C = { x: 1.5, y: -16.1 };
	const HALF_A_C = { x: 53.7, y: 41.3 };
	const HALF_B_C = { x: -2.0, y: 13.0 };

	const GAME = {
		minGap: 0.85,
		maxGap: 2.6,
		flightMin: 0.72,
