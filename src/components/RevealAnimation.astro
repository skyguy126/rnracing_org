	function ensureGameFruitPool() {
		if (gameFruits.length) return;
		for (let i = 0; i < GAME.maxFruits; i++) {
			gameFruits.push(
				blankGameFruit({
					whole: cloneFruitImg(lemonWhole, lemonLayer),
					halfA: cloneFruitImg(halfA, lemonLayer),
					halfB: cloneFruitImg(halfB, lemonLayer),
					slash: cloneFruitImg(slash, revealScene),
					splash: cloneFruitImg(splash, revealScene),
					droplets: cloneFruitImg(droplets, revealScene),
				}),
			);
		}
	}

	function resetGameFruit(f: GameFruit) {
		f.whole.style.opacity = '0';
		f.whole.style.visibility = 'hidden';
		f.halfA.style.opacity = '0';
		f.halfB.style.opacity = '0';
		f.halfA.style.visibility = 'hidden';
		f.halfB.style.visibility = 'hidden';
		hideFx(f.slash);
		hideFx(f.splash);
		hideFx(f.droplets);
		f.lemon = blankProjectile();
		f.halfAState = blankProjectile();
		f.halfBState = blankProjectile();
		f.busy = false;
		f.sliced = false;
		f.lemonLaunched = false;
	}

	function acquireGameFruit() {
		return gameFruits.find((f) => !f.busy) ?? null;
	}

	function anyBusyFruit() {
		return gameFruits.some((f) => f.busy);
	}

	function launchGameFruit(f: GameFruit, startX: number) {
		const { w, h } = size();
		const startY = h + 100;
		const apexX = startX + rand(-w * 0.05, w * 0.05);
		const apexY = h * rand(0.32, 0.42);
		const flight = rand(GAME.flightMin, GAME.flightMax);
		const vx = (apexX - startX) / flight + rand(-30, 30);
		const vy = (apexY - startY) / flight - 0.5 * GRAVITY * flight + rand(-40, 40);

		f.lemon = {
			x: startX,
			y: startY,
			vx,
			vy,
			rotation: rand(-35, 15),
			angularVelocity: rand(140, 300) * (Math.random() < 0.5 ? -1 : 1),
			visible: true,
		};
		f.busy = true;
		f.lemonLaunched = true;
		f.sliced = false;
		f.halfAState = blankProjectile();
		f.halfBState = blankProjectile();
		f.whole.style.opacity = '1';
		f.whole.style.visibility = 'visible';
		f.halfA.style.visibility = 'hidden';
		f.halfB.style.visibility = 'hidden';
		f.halfA.style.opacity = '0';
		f.halfB.style.opacity = '0';
		hideFx(f.slash);
		hideFx(f.splash);
		hideFx(f.droplets);
		setTransform(f.whole, f.lemon.x, f.lemon.y, f.lemon.rotation, 1);
	}

	function renderGameHalves(f: GameFruit) {
		const a = halfAlign('a');
		const b = halfAlign('b');
		setTransform(f.halfA, f.halfAState.x + a.x, f.halfAState.y + a.y, f.halfAState.rotation, 1);
		setTransform(f.halfB, f.halfBState.x + b.x, f.halfBState.y + b.y, f.halfBState.rotation, 1);
	}

	function sliceGameFruit(
		f: GameFruit,
		nowSec: number,
		opts: { swipeDx: number; swipeDy: number },
	) {
		if (f.sliced || !f.lemonLaunched) return;
		f.sliced = true;
		f.cutPoint = { x: f.lemon.x, y: f.lemon.y };
		f.fxSliceAt = nowSec;
		f.fxSlashEnd = nowSec + GAME.slashMs;
		f.fxSplashEnd = nowSec + GAME.splashMs;

		const dx = opts.swipeDx;
		const dy = opts.swipeDy;
		const swipeLen = Math.hypot(dx, dy) || 1;
		const nx = -dy / swipeLen;
		const ny = dx / swipeLen;
		const impulse = GAME.separationImpulse;
		const extraSpin = GAME.extraSpin;
		const baseRot = f.lemon.rotation;

		f.slashAngleDeg = (Math.atan2(dy, dx) * 180) / Math.PI + GAME.slashArtOffsetDeg;
		f.slashScale = 1.05;
		f.splashRot = rand(-12, 14);
		f.splashScale = rand(0.86, 0.96);
		f.dropRot = rand(-16, 8);
		f.dropScale = rand(0.84, 0.94);

		score += 1;
		renderScoreDigits(score, true);

		f.halfAState = {
			x: f.lemon.x,
			y: f.lemon.y,
			vx: f.lemon.vx + nx * impulse,
			vy: f.lemon.vy + ny * impulse,
			rotation: baseRot,
			angularVelocity: f.lemon.angularVelocity - extraSpin,
			visible: true,
		};
		f.halfBState = {
			x: f.lemon.x,
			y: f.lemon.y,
			vx: f.lemon.vx - nx * impulse,
			vy: f.lemon.vy - ny * impulse,
			rotation: baseRot,
			angularVelocity: f.lemon.angularVelocity + extraSpin,
			visible: true,
		};

		f.lemon.visible = false;
		f.whole.style.opacity = '0';
		f.whole.style.visibility = 'hidden';
		f.halfA.style.visibility = 'visible';
		f.halfB.style.visibility = 'visible';
		f.halfA.style.opacity = '1';
		f.halfB.style.opacity = '1';
		renderGameHalves(f);

		showFx(f.slash, '1');
		showFx(f.splash, '1');
		showFx(f.droplets, '1');
		setTransform(f.slash, f.cutPoint.x, f.cutPoint.y, f.slashAngleDeg, f.slashScale);
		setTransform(f.splash, f.cutPoint.x, f.cutPoint.y, f.splashRot, f.splashScale);
		setTransform(f.droplets, f.cutPoint.x + 6, f.cutPoint.y - 8, f.dropRot, f.dropScale);
	}

	function applyGameFruitFx(f: GameFruit, nowSec: number) {
		if (!f.busy || !f.sliced) {
			if (f.busy && !f.sliced) {
				hideFx(f.slash);
				hideFx(f.splash);
				hideFx(f.droplets);
			}
			return;
		}

		const slashDur = Math.max(0.001, f.fxSlashEnd - f.fxSliceAt);
		const slashLife = clamp((nowSec - f.fxSliceAt) / slashDur, 0, 1);
		const slashOpacity = nowSec < f.fxSlashEnd ? 1 - slashLife * 0.25 : 0;
		if (slashOpacity <= 0) hideFx(f.slash);
		else showFx(f.slash, String(slashOpacity));
		setTransform(
			f.slash,
			f.cutPoint.x,
			f.cutPoint.y,
			f.slashAngleDeg + slashLife * 12,
			f.slashScale + slashLife * 0.18,
		);

		const splashT = clamp((nowSec - f.fxSliceAt) / Math.max(0.001, f.fxSplashEnd - f.fxSliceAt), 0, 1);
		const splashOpacity = splashT < 0.18 ? splashT / 0.18 : 1 - (splashT - 0.18) / 0.82;
		const splashVal = clamp(splashOpacity, 0, 1);
		if (splashVal <= 0) hideFx(f.splash);
		else showFx(f.splash, String(splashVal));
		setTransform(
			f.splash,
			f.cutPoint.x,
			f.cutPoint.y,
			f.splashRot + splashT * 14,
			f.splashScale + splashT * 0.4,
		);

		const dropT = clamp((nowSec - f.fxSliceAt - 0.03) / 0.4, 0, 1);
		const dropOpacity = dropT < 0.22 ? dropT / 0.22 : 1 - (dropT - 0.22) / 0.78;
		const dropVal = clamp(dropOpacity, 0, 1);
		if (dropVal <= 0) hideFx(f.droplets);
		else showFx(f.droplets, String(dropVal));
		setTransform(
			f.droplets,
			f.cutPoint.x + dropT * 16,
			f.cutPoint.y - 8 - dropT * 30,
			f.dropRot + dropT * 18,
			f.dropScale + dropT * 0.28,
		);
	}

	function finishGameFruit(f: GameFruit, nowSec: number) {
		resetGameFruit(f);
		if (!anyBusyFruit() && pendingLaunches.length === 0) {
			scheduleNextWave(nowSec);
		}
	}

	function updateGameFruit(f: GameFruit, nowSec: number, dt: number) {
		if (!f.busy) return;

		if (!f.sliced) {
			integrate(f.lemon, dt);
			setTransform(f.whole, f.lemon.x, f.lemon.y, f.lemon.rotation, 1);
			if (offscreenBottom(f.lemon.y)) {
				finishGameFruit(f, nowSec);
			}
			return;
		}

		integrate(f.halfAState, dt);
		integrate(f.halfBState, dt);
		renderGameHalves(f);

		if (offscreenBottom(f.halfAState.y) && offscreenBottom(f.halfBState.y)) {
			finishGameFruit(f, nowSec);
		}
	}

	function scheduleNextWave(fromSec: number) {
		nextWaveAt = fromSec + rand(GAME.minGap, GAME.maxGap);
		pendingLaunches = [];
	}

	function startWave(nowSec: number) {
		ensureGameFruitPool();
		const free = gameFruits.filter((f) => !f.busy).length;
		if (free <= 0) {
			nextWaveAt = nowSec + 0.35;
			return;
		}
		const count = Math.min(pickWaveCount(), free);
		const xs = spawnXs(count);
		pendingLaunches = xs.map((x, i) => ({
			at: nowSec + (i === 0 ? 0 : rand(GAME.waveStaggerMin, GAME.waveStaggerMax) * i),
			x,
		}));
	}

	function sliceFruit(
		nowSec: number,
		opts?: {
			swipeDx?: number;
			swipeDy?: number;
			awardScore?: boolean;
			slashAngle?: number;
			slashEnd?: number;
			splashEnd?: number;
			sliceAt?: number;
		},
	) {
		if (sliced || !lemonLaunched) return;
		sliced = true;
		fruit.sliced = true;
		cutPoint = { x: lemon.x, y: lemon.y };
		fxSliceAt = opts?.sliceAt ?? nowSec;
		fxSlashEnd = opts?.slashEnd ?? nowSec + GAME.slashMs;
		fxSplashEnd = opts?.splashEnd ?? nowSec + GAME.splashMs;

		const dx = opts?.swipeDx ?? 1;
		const dy = opts?.swipeDy ?? 0;
		const swipeLen = Math.hypot(dx, dy) || 1;
		const ndx = dx / swipeLen;
		const ndy = dy / swipeLen;
		const nx = -ndy;
		const ny = ndx;
		const impulse = GAME.separationImpulse;
		const extraSpin = GAME.extraSpin;
		const baseRot = lemon.rotation;

		if (opts?.slashAngle != null) {
			slashAngleDeg = opts.slashAngle;
		} else {
			slashAngleDeg = (Math.atan2(dy, dx) * 180) / Math.PI + GAME.slashArtOffsetDeg;
		}

		slashScale = 1.05;
		splashRot = rand(-12, 14);
		splashScale = rand(0.86, 0.96);
		dropRot = rand(-16, 8);
		dropScale = rand(0.84, 0.94);

		if (opts?.awardScore) {
			score += 1;
			renderScoreDigits(score, true);
		}

		halfAState = {
			x: lemon.x,
			y: lemon.y,
			vx: lemon.vx + nx * impulse,
			vy: lemon.vy + ny * impulse,
			rotation: baseRot,
			angularVelocity: lemon.angularVelocity - extraSpin,
			visible: true,
		};
		halfBState = {
			x: lemon.x,
			y: lemon.y,
			vx: lemon.vx - nx * impulse,
			vy: lemon.vy - ny * impulse,
			rotation: baseRot,
			angularVelocity: lemon.angularVelocity + extraSpin,
			visible: true,
		};

		// Intro keeps the older choreographed half impulses + FX for the scripted cut.
		if (phase === 'reveal') {
			const carryX = lemon.vx * 0.2;
			const carryY = Math.min(lemon.vy * 0.15, 40);
			const impulseX = Math.min(size().w * 0.18, 200);
			const impulseY = -160;
			halfAState = {
				x: lemon.x,
				y: lemon.y,
				vx: carryX - impulseX,
				vy: carryY + impulseY * 0.35,
				rotation: baseRot,
				angularVelocity: -200,
				visible: true,
			};
			halfBState = {
				x: lemon.x,
				y: lemon.y,
				vx: carryX + impulseX,
				vy: carryY + impulseY,
				rotation: baseRot,
				angularVelocity: 210,
				visible: true,
			};
			slashAngleDeg = -28;
			slashScale = 1.05;
			splashRot = 6;
			splashScale = 0.9;
			dropRot = -10;
			dropScale = 0.88;
		}

		lemon.visible = false;
		fruit.active = false;
		lemonWhole.style.opacity = '0';
		lemonWhole.style.visibility = 'hidden';
		halfA.style.visibility = 'visible';
		halfB.style.visibility = 'visible';
		halfA.style.opacity = '1';
		halfB.style.opacity = '1';
		renderHalves();

		slash.style.opacity = '1';
		splash.style.opacity = '1';
		droplets.style.opacity = '1';
		setTransform(slash, cutPoint.x, cutPoint.y, slashAngleDeg, slashScale);
		setTransform(splash, cutPoint.x, cutPoint.y, splashRot, splashScale);
		setTransform(droplets, cutPoint.x + 6, cutPoint.y - 8, dropRot, dropScale);
	}

	function applyFx(nowSec: number) {
		if (!sliced) {
			slash.style.opacity = '0';
			splash.style.opacity = '0';
			droplets.style.opacity = '0';
			return;
		}

		const slashDur = Math.max(0.001, fxSlashEnd - fxSliceAt);
		const slashLife = clamp((nowSec - fxSliceAt) / slashDur, 0, 1);
		slash.style.opacity = String(nowSec < fxSlashEnd ? 1 - slashLife * 0.25 : 0);
		setTransform(
			slash,
			cutPoint.x,
			cutPoint.y,
			slashAngleDeg + slashLife * 12,
			slashScale + slashLife * 0.18,
		);

		const splashT = clamp((nowSec - fxSliceAt) / Math.max(0.001, fxSplashEnd - fxSliceAt), 0, 1);
		const splashOpacity = splashT < 0.18 ? splashT / 0.18 : 1 - (splashT - 0.18) / 0.82;
		splash.style.opacity = String(clamp(splashOpacity, 0, 1));
		setTransform(
			splash,
			cutPoint.x,
			cutPoint.y,
			splashRot + splashT * 14,
			splashScale + splashT * 0.4,
		);

		const dropT = clamp((nowSec - fxSliceAt - 0.03) / 0.4, 0, 1);
		const dropOpacity = dropT < 0.22 ? dropT / 0.22 : 1 - (dropT - 0.22) / 0.78;
		droplets.style.opacity = String(clamp(dropOpacity, 0, 1));
		setTransform(
			droplets,
			cutPoint.x + dropT * 16,
			cutPoint.y - 8 - dropT * 30,
			dropRot + dropT * 18,
			dropScale + dropT * 0.28,
		);
	}

	function trySliceFromSwipe(p0: PointerSample, p1: PointerSample, nowSec: number) {
		if (phase !== 'game' || !gameActive) return;

		const segLen = dist(p0.x, p0.y, p1.x, p1.y);
		if (segLen < GAME.minSegmentPx) return;

		const dt = Math.max(0.001, (p1.time - p0.time) / 1000);
		const speed = segLen / dt;
		if (speed < GAME.minSwipeSpeed) return;

		const radius = hitRadius();
		for (const f of gameFruits) {
			if (!f.busy || f.sliced || !f.lemonLaunched || !f.lemon.visible) continue;
			const distance = pointSegmentDistance(f.lemon.x, f.lemon.y, p0.x, p0.y, p1.x, p1.y);
			if (distance > radius) continue;
			sliceGameFruit(f, nowSec, {
				swipeDx: p1.x - p0.x,
				swipeDy: p1.y - p0.y,
			});
			return;
		}
	}

	function onPointerDown(e: PointerEvent) {
		if (!gameActive || phase !== 'game') return;
		if (e.pointerType === 'mouse' && finePointerMq.matches) {
			// Desktop uses continuous hover motion; button not required.
			return;
		}
		pointerDown = true;
		activePointerId = e.pointerId;
		try {
			stage.setPointerCapture(e.pointerId);
		} catch {
			/* ignore */
		}
		const pt = stagePointFromEvent(e);
		const sample = { x: pt.x, y: pt.y, time: performance.now() };
		lastPointer = sample;
		pointerSamples = [sample];
		ensureTrailLoop();
		e.preventDefault();
	}

	function onPointerMove(e: PointerEvent) {
		if (!gameActive || phase !== 'game') return;

		const isFineMouse = e.pointerType === 'mouse' && finePointerMq.matches;
		if (!isFineMouse) {
			if (!pointerDown || activePointerId !== e.pointerId) return;
		} else {
			desktopTracking = true;
		}

		const pt = stagePointFromEvent(e);
		const now = performance.now();
		const sample: PointerSample = { x: pt.x, y: pt.y, time: now };
		const prev = lastPointer;
		pushPointerSample(sample.x, sample.y, sample.time);
		lastPointer = sample;

		if (prev) {
			const elapsed = startTime ? (now - startTime) / 1000 : 0;
			trySliceFromSwipe(prev, sample, elapsed);
		}

		if (!isFineMouse) e.preventDefault();
	}

	function onPointerUp(e: PointerEvent) {
		if (activePointerId !== null && e.pointerId !== activePointerId) return;
		pointerDown = false;
		activePointerId = null;
		lastPointer = null;
		try {
			if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
		} catch {
			/* ignore */
		}
	}

	function onPointerCancel(e: PointerEvent) {
		onPointerUp(e);
	}

	function onPointerLeave(e: PointerEvent) {
		if (e.pointerType === 'mouse' && finePointerMq.matches) {
			desktopTracking = false;
			lastPointer = null;
			// Let existing trail samples fade naturally.
		}
	}

	function bindGameplayInput() {
		stage.addEventListener('pointerdown', onPointerDown, { passive: false });
		stage.addEventListener('pointermove', onPointerMove, { passive: false });
		stage.addEventListener('pointerup', onPointerUp);
		stage.addEventListener('pointercancel', onPointerCancel);
		stage.addEventListener('pointerleave', onPointerLeave);
	}

	function unbindGameplayInput() {
		stage.removeEventListener('pointerdown', onPointerDown);
		stage.removeEventListener('pointermove', onPointerMove);
		stage.removeEventListener('pointerup', onPointerUp);
		stage.removeEventListener('pointercancel', onPointerCancel);
		stage.removeEventListener('pointerleave', onPointerLeave);
	}

	function updateRevealLemon(elapsed: number, dt: number) {
		if (revealTossDone) return;

		if (elapsed < T.lemonLaunch) {
			lemonWhole.style.opacity = '0';
			return;
		}

		if (!lemonLaunched) launchRevealLemon();

		if (!sliced && elapsed >= T.slice) {
			sliceFruit(elapsed, {
				slashAngle: -28,
				slashEnd: T.slashEnd,
				splashEnd: T.splashEnd,
				sliceAt: T.slice,
				awardScore: false,
			});
		}

		if (!sliced) {
			integrate(lemon, dt);
			syncFruitFromLemon();
			renderWhole();
			return;
		}

		integrate(halfAState, dt);
		integrate(halfBState, dt);
		renderHalves();

		if (bothHalvesGone()) {
			hideLemonActors();
			revealTossDone = true;
		}
	}

	function updateGame(nowSec: number, dt: number) {
		ensureGameFruitPool();

		if (pendingLaunches.length === 0 && !anyBusyFruit() && nowSec >= nextWaveAt) {
			startWave(nowSec);
		}

		while (pendingLaunches.length && pendingLaunches[0]!.at <= nowSec) {
			const launch = pendingLaunches.shift()!;
			const slot = acquireGameFruit();
			if (!slot) break;
			launchGameFruit(slot, launch.x);
		}

		for (const f of gameFruits) {
			updateGameFruit(f, nowSec, dt);
			applyGameFruitFx(f, nowSec);
		}
	}

	function activateGame(nowSec: number) {
		phase = 'game';
		gameActive = true;
		revealTossDone = true;
		freezeLogoAndCopy();
		hideLemonActors();
		ensureGameFruitPool();
		for (const f of gameFruits) resetGameFruit(f);
		pendingLaunches = [];
		stage.classList.add('is-game-active');
		showScoreHud();
		resizeSwipeCanvas();
		bindGameplayInput();
		scheduleNextWave(nowSec + 0.35);
	}

	let musicMuted = false;
	let musicStarted = false;
	let musicSeeking = false;
	let musicDisposed = false;
	let musicMetaBound = false;
	let audioOrigin = 0;
	let musicRaf = 0;

	function musicElapsed() {
		if (!audioOrigin) return 0;
		return (performance.now() - audioOrigin) / 1000;
	}

	function musicGain(elapsed: number) {
		return smoothstep(0, T.slice, elapsed);
	}

	function prerollTime() {
		return Math.max(0, SONG_AT_SLICE - T.slice);
	}

	function seekPreroll() {
		if (music.readyState < 1) return;
		const target = prerollTime();
		try {
			if (Math.abs(music.currentTime - target) > 0.2) music.currentTime = target;
		} catch {
			/* metadata not seekable yet */
		}
	}

	if (music.readyState >= 1) seekPreroll();
	else music.addEventListener('loadedmetadata', () => seekPreroll(), { once: true });

	function prerollBuffered() {
		const target = prerollTime();
		const ranges = music.buffered;
		for (let i = 0; i < ranges.length; i++) {
			try {
				if (ranges.start(i) <= target + 0.25 && ranges.end(i) >= target + 1) return true;
			} catch {
				/* buffered ranges changed while reading */
			}
		}
		return false;
	}

	function waitForPreroll() {
		if (music.readyState >= 1) seekPreroll();
		else music.addEventListener('loadedmetadata', () => seekPreroll(), { once: true });

		return new Promise<void>((resolve) => {
			const started = performance.now();
			let settled = false;
			let prerollSeeked = false;

			const finish = () => {
				if (settled) return;
				settled = true;
				music.removeEventListener('canplay', onMedia);
				music.removeEventListener('progress', onMedia);
				music.removeEventListener('seeked', onSeeked);
				resolve();
			};

			const onSeeked = () => {
				if (Math.abs(music.currentTime - prerollTime()) < 0.45) prerollSeeked = true;
				onMedia();
			};

			const onMedia = () => {
				const waited = performance.now() - started;
				if (waited < REVEAL_BOOT.minDelayMs) return;
				const atPreroll = Math.abs(music.currentTime - prerollTime()) < 0.45;
				const canPlayPreroll = music.readyState >= 3 && (atPreroll || prerollSeeked);
				if (prerollBuffered() || canPlayPreroll) finish();
			};

			music.addEventListener('canplay', onMedia);
			music.addEventListener('progress', onMedia);
			music.addEventListener('seeked', onSeeked);
			window.setTimeout(onMedia, REVEAL_BOOT.minDelayMs);
			window.setTimeout(finish, REVEAL_BOOT.maxDelayMs);
		});
	}

	function musicTime(elapsed: number) {
		return SONG_AT_SLICE - (T.slice - elapsed);
	}

	function renderSoundToggle() {
		music.muted = musicMuted;
		soundToggle.classList.toggle('is-muted', musicMuted);
		soundToggle.setAttribute('aria-pressed', musicMuted ? 'true' : 'false');
		soundToggle.setAttribute('aria-label', musicMuted ? 'Unmute music' : 'Mute music');
	}

	function alignMusic() {
		if (!audioOrigin || music.readyState < 1 || music.ended) return;
		const desired = Math.max(0, musicTime(musicElapsed()));
		if (Number.isFinite(music.duration) && desired >= music.duration - 0.05) return;
		try {
			if (Math.abs(music.currentTime - desired) > 0.08) music.currentTime = desired;
		} catch {
			/* not seekable yet */
		}
	}

	function ensureMusicMetaAlign() {
		if (music.readyState >= 1) {
			alignMusic();
			return;
		}
		if (musicMetaBound) return;
		musicMetaBound = true;
		music.addEventListener('loadedmetadata', () => alignMusic(), { once: true });
	}

	function syncMusic(elapsed: number) {
		if (!musicStarted || music.ended || music.paused || musicDisposed) return;
		const desired = Math.max(0, musicTime(elapsed));
		if (Number.isFinite(music.duration) && desired >= music.duration - 0.05) return;
		if (!musicSeeking && music.readyState >= 1 && Math.abs(music.currentTime - desired) > 0.6) {
			try {
				music.currentTime = desired;
			} catch {
				/* ignore */
			}
		}
		if (!musicMuted) {
			const gain = musicGain(elapsed);
			if (Math.abs(music.volume - gain) > 0.012) music.volume = gain;
		}
		if (music.muted !== musicMuted) music.muted = musicMuted;
	}

	function musicLoop() {
		if (musicDisposed) return;
		syncMusic(musicElapsed());
		if (!music.ended) musicRaf = window.requestAnimationFrame(musicLoop);
		else musicRaf = 0;
	}

	function startMusic() {
		if (musicDisposed || music.ended || !audioOrigin) return;
		music.muted = musicMuted;
		if (musicStarted && !music.paused) return;
		if (!musicMuted) music.volume = musicGain(musicElapsed());
		ensureMusicMetaAlign();
		music
			.play()
			.then(() => {
				if (musicDisposed) {
					music.pause();
					return;
				}
				musicStarted = true;
				alignMusic();
				music.muted = musicMuted;
				if (!musicMuted) music.volume = musicGain(musicElapsed());
			})
			.catch(() => {
				if (music.paused) musicStarted = false;
			});
	}

	function beginMusicClock(now: number) {
		if (audioOrigin || musicDisposed) return;
		audioOrigin = now;
		startMusic();
		if (!musicRaf) musicRaf = window.requestAnimationFrame(musicLoop);
	}

	function hitsSoundToggle(event: Event) {
		const target = event.target;
		if (target instanceof Node && soundToggle.contains(target)) return true;
		return event.composedPath().includes(soundToggle);
	}

	function onMusicGesture(event: Event) {
		if (!audioOrigin || musicDisposed || hitsSoundToggle(event)) return;
		if (musicStarted && !music.paused) return;
		startMusic();
	}

	function stopMusic() {
		musicDisposed = true;
		if (musicRaf) cancelAnimationFrame(musicRaf);
		musicRaf = 0;
		music.pause();
	}

	let muteToggleAt = 0;

	function toggleMusicMute(event: Event) {
		event.preventDefault();
		event.stopPropagation();
		const now = performance.now();
		if (now - muteToggleAt < 280) return;
		muteToggleAt = now;
		musicMuted = !musicMuted;
		renderSoundToggle();
		if (!musicMuted && audioOrigin) music.volume = musicGain(musicElapsed());
		if (!audioOrigin || musicDisposed || music.ended) return;
		if (!musicStarted || music.paused) startMusic();
	}

	soundToggle.addEventListener('pointerdown', (event) => {
		event.stopPropagation();
	});
	soundToggle.addEventListener('click', toggleMusicMute);

	music.addEventListener('seeking', () => {
		musicSeeking = true;
	});
	music.addEventListener('seeked', () => {
		musicSeeking = false;
	});

	function tick(now: number) {
		if (!startTime) {
			startTime = now;
			lastTime = now;
			beginMusicClock(now);
		}

		const elapsed = (now - startTime) / 1000;
		const dt = clamp((now - lastTime) / 1000, 0, MAX_DT);
		lastTime = now;

		if (phase === 'reveal') {
			applyPaint(elapsed);
			applyLogo(elapsed);
			applyComingSoon(elapsed);
			updateRevealLemon(elapsed, dt);
			applyFx(elapsed);

			if (elapsed >= T.gameStart) {
				activateGame(elapsed);
			}
		} else {
			freezeLogoAndCopy();
			updateGame(elapsed, dt);
		}

		rafId = window.requestAnimationFrame(tick);
	}

	function runReducedMotion() {
		const assets = [logo, lemonWhole, halfA, halfB, slash, splash, droplets, comingSoon];
		let start = 0;
		let id = 0;

		const paintQuick = (t: number) => {
			strokes.forEach((el, i) => {
				const cfg = PAINT[i];
				if (!cfg) return;
				const local = clamp((t - 0.05 - i * 0.02) / 0.35, 0, 1);
				const e = easeOutCubic(local);
				el.style.setProperty('--srx', `${cfg.rx * e}%`);
				el.style.setProperty('--sry', `${cfg.ry * e}%`);
			});
			bgFull.style.opacity = String(smoothstep(0.1, 0.45, t));
			veil.style.opacity = String(1 - smoothstep(0, 0.35, t));
		};

		const frame = (now: number) => {
			if (!start) {
				start = now;
				beginMusicClock(now);
			}
			const elapsed = (now - start) / 1000;

			paintQuick(elapsed);

			const logoT = clamp((elapsed - 0.2) / 0.45, 0, 1);
			const lt = logoTarget();
			logo.style.opacity = String(easeOutCubic(logoT));
			setTransform(logo, lt.x, lt.y, 0, lerp(0.85, 1, easeOutCubic(logoT)), 0);

			hideLemonActors();

			const soonT = clamp((elapsed - 0.45) / 0.45, 0, 1);
			const c = comingTarget();
			comingSoon.style.opacity = String(easeOutCubic(soonT));
			setTransform(comingSoon, c.x, c.y, 0, 1, lerp(10, 0, easeOutCubic(soonT)));

			if (elapsed >= 1.15) {
				freezeLogoAndCopy();
				hideLemonActors();
				score = 0;
				showScoreHud();
				id = 0;
				return;
			}
			id = window.requestAnimationFrame(frame);
		};

		void Promise.all(
			assets.map(
				(img) =>
					img.complete
						? Promise.resolve()
						: new Promise<void>((resolve) => {
								img.addEventListener('load', () => resolve(), { once: true });
								img.addEventListener('error', () => resolve(), { once: true });
							}),
			),
		).then(() => {
			id = window.requestAnimationFrame(frame);
		});

		window.addEventListener(
			'pagehide',
			() => {
				if (id) cancelAnimationFrame(id);
			},
			{ once: true },
		);
	}

	function onResize() {
		resizeSwipeCanvas();
		if (phase === 'game' || phase === 'reveal') {
			freezeLogoAndCopy();
		}
	}

	function onVisibilityChange() {
		lastTime = performance.now();
		if (document.hidden || musicDisposed || music.ended || !audioOrigin) return;
		if (!musicStarted || music.paused) startMusic();
	}

	function cleanup() {
		if (rafId) cancelAnimationFrame(rafId);
		if (trailRafId) cancelAnimationFrame(trailRafId);
		stopMusic();
		window.removeEventListener('pointerdown', onMusicGesture, { capture: true });
		window.removeEventListener('keydown', onMusicGesture, { capture: true });
		unbindGameplayInput();
		gameActive = false;
		stage.classList.remove('is-game-active');
	}

	async function boot() {
		preloadScoreDigits();
		renderScoreDigits(0, false);
		resizeSwipeCanvas();
		window.addEventListener('pointerdown', onMusicGesture, { capture: true });
		window.addEventListener('keydown', onMusicGesture, { capture: true });
		window.addEventListener('resize', onResize);
		window.addEventListener('orientationchange', onResize);
		document.addEventListener('visibilitychange', onVisibilityChange);
		window.addEventListener('pagehide', cleanup, { once: true });

		await waitForPreroll();
		if (musicDisposed) return;

		revealRoot.classList.add('is-visible');
		revealLoading?.classList.add('is-done');
		revealLoading?.setAttribute('aria-hidden', 'true');

		if (reducedMotion) {
			runReducedMotion();
			return;
		}

		rafId = window.requestAnimationFrame(tick);
	}

	if (document.readyState === 'complete') void boot();
	else window.addEventListener('load', () => void boot(), { once: true });
</script>
