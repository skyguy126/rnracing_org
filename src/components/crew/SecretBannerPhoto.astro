---
interface Props {
	className?: string;
	alt?: string;
	hidden?: boolean;
}

const { className = 'crew-photo', alt = 'Portrait', hidden = false } = Astro.props;

const BLUE = '#0136b6';
const up = '539.5,433.0 448.6,590.5 630.4,590.5';
const down = '539.5,643.0 448.6,485.5 630.4,485.5';
---

<svg
	class={className}
	data-theme-photo="dark"
	viewBox="0 0 1080 1080"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label={alt}
	hidden={hidden || undefined}
>
	<rect width="1080" height="1080" fill="#1d4ed7"></rect>
	<rect x="206" y="298" width="667" height="483" fill="#fff"></rect>
	<rect x="206" y="340" width="667" height="74" fill={BLUE}></rect>
	<rect x="206" y="662" width="667" height="74" fill={BLUE}></rect>
	<polygon points={up} fill="none" stroke={BLUE} stroke-width="18" stroke-linejoin="miter"></polygon>
	<polygon points={down} fill="none" stroke={BLUE} stroke-width="18" stroke-linejoin="miter"></polygon>
</svg>
<svg
	class={className}
	data-theme-photo="light"
	viewBox="0 0 1080 1080"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	hidden={hidden || undefined}
>
	<rect width="1080" height="1080" fill="#18181a"></rect>
	<rect x="206" y="298" width="667" height="483" fill="#fff"></rect>
	<rect x="206" y="340" width="667" height="74" fill={BLUE}></rect>
	<rect x="206" y="662" width="667" height="74" fill={BLUE}></rect>
	<polygon points={up} fill="none" stroke={BLUE} stroke-width="18" stroke-linejoin="miter"></polygon>
	<polygon points={down} fill="none" stroke={BLUE} stroke-width="18" stroke-linejoin="miter"></polygon>
</svg>
