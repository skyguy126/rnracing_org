---
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import type { CrewMember } from '../../data/crew';

interface Props {
	members: CrewMember[];
}

const { members } = Astro.props;
---

<div class="member-modal" hidden>
	<div class="member-modal-backdrop" data-modal-close aria-hidden="true"></div>
	<div
		class="member-modal-panel"
		role="dialog"
		aria-modal="true"
		aria-labelledby="member-modal-name"
		tabindex="-1"
	>
		<button type="button" class="member-modal-close" data-modal-close aria-label="Close profile">
			<span aria-hidden="true">&times;</span>
		</button>

		<div class="member-modal-layout">
			<div id="member-modal-photo">
				<PhotoPlaceholder initials="RN" large />
			</div>
			<div class="member-modal-content">
				<h2 id="member-modal-name"></h2>
				<p class="member-modal-title" id="member-modal-title"></p>
				<p class="member-modal-bio" id="member-modal-bio"></p>
			</div>
		</div>
	</div>
</div>

<script id="crew-members-data" type="application/json" set:html={JSON.stringify(members)} />

<script>
	const members = JSON.parse(
		document.getElementById('crew-members-data')?.textContent || '[]',
	) as Array<{ name: string; title: string; bio: string }>;

	const modal = document.querySelector('.member-modal') as HTMLDivElement | null;
	const panel = document.querySelector('.member-modal-panel') as HTMLDivElement | null;
	const nameEl = document.getElementById('member-modal-name');
	const titleEl = document.getElementById('member-modal-title');
	const bioEl = document.getElementById('member-modal-bio');
	const photoEl = document.getElementById('member-modal-photo');
	const triggers = document.querySelectorAll<HTMLButtonElement>('.photo-trigger');

	let lastFocused: HTMLElement | null = null;

	const openModal = (index: number) => {
		const member = members[index];
		if (!member || !modal || !panel || !nameEl || !titleEl || !bioEl || !photoEl) return;

		lastFocused = document.activeElement as HTMLElement | null;
		nameEl.textContent = member.name;
		titleEl.textContent = member.title;
		bioEl.textContent = member.bio;
		photoEl.querySelector('.photo-icon')!.textContent = member.name.slice(0, 2).toUpperCase();

		modal.hidden = false;
		document.body.classList.add('modal-open');
		panel.focus();
	};

	const closeModal = () => {
		if (!modal) return;
		modal.hidden = true;
		document.body.classList.remove('modal-open');
		lastFocused?.focus();
	};

	triggers.forEach((trigger) => {
		trigger.addEventListener('click', () => openModal(Number(trigger.dataset.memberIndex)));
	});

	document.querySelectorAll('[data-modal-close]').forEach((target) => {
		target.addEventListener('click', closeModal);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
	});
</script>

<style>
	.member-modal {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-items: center;
		padding: 1.5rem;
	}

	.member-modal[hidden] {
		display: none;
	}

	.member-modal-backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--black) 55%, transparent);
		backdrop-filter: blur(8px);
	}

	.member-modal-panel {
		position: relative;
		width: min(100%, 56rem);
		max-height: min(90dvh, 40rem);
		overflow: auto;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 0.875rem;
		background: var(--surface);
		box-shadow: 0 24px 64px color-mix(in srgb, var(--black) 35%, transparent);
	}

	.member-modal-close {
		position: absolute;
		top: 0.875rem;
		right: 0.875rem;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg);
		color: var(--muted);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
	}

	.member-modal-close:hover {
		color: var(--text);
		border-color: color-mix(in srgb, var(--blue) 35%, var(--border));
	}

	.member-modal-layout {
		display: grid;
		grid-template-columns: minmax(12rem, 18rem) 1fr;
		gap: 2rem;
		align-items: start;
	}

	.member-modal-content h2 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 5vw, 2.75rem);
	}

	.member-modal-title {
		margin: 0 0 1.25rem;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--blue);
	}

	.member-modal-bio {
		margin: 0;
		font-size: 1.0625rem;
		line-height: 1.75;
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.member-modal {
			padding: 1rem;
		}

		.member-modal-panel {
			padding: 1.25rem;
		}

		.member-modal-layout {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.member-modal-layout :global(.photo-placeholder) {
			max-width: 14rem;
			margin: 0 auto;
		}
	}
</style>

<style is:global>
	body.modal-open {
		overflow: hidden;
	}
</style>
