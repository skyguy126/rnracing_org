---
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import CrewPhoto from './CrewPhoto.astro';
import {
	crewMembers,
	crewSlug,
	getCrewIndex,
	getCrewMemberBySlug,
	getDirectReports,
	getInitials,
	getManagerChain,
	getReportTotal,
	getVisibleRoot,
} from '../../data/crew';

const showSecret = false;
const selected = getCrewMemberBySlug('nyle') ?? getVisibleRoot(showSecret);
const chain = selected ? getManagerChain(selected.name, showSecret) : [];
const reports = selected ? getDirectReports(selected.name, showSecret) : [];
const chainSlugs = new Set(chain.map((member) => crewSlug(member.name)));
const reportSlugs = new Set(reports.map((member) => crewSlug(member.name)));
const manager = chain[chain.length - 1];
---

<div class="mobile-org-browser" data-org-browser>
	<script is:inline>
		(function () {
			var hash = location.hash.replace(/^#/, '');
			var rn = document.documentElement.hasAttribute('data-rn-mode');
			if (hash || rn) document.documentElement.dataset.orgPending = '';
		})();
	</script>

	<div class="org-browser-stage">
		<ol class="org-chain-list" aria-label="Chain of command" hidden={chain.length === 0}>
			{
				crewMembers.map((member) => {
					const slug = crewSlug(member.name);
					const index = getCrewIndex(member.name);
					return (
						<li
							class="org-chain-item"
							data-org-slug={slug}
							data-secret={member.secret ? '' : undefined}
							hidden={!chainSlugs.has(slug)}
						>
							<CrewPhoto member={member} index={index} />
							<button type="button" class="org-chain-select" data-org-select={slug}>
								<span class="org-person-copy">
									<span class="org-person-name">{member.name}</span>
									<span class="org-person-title">{member.title}</span>
								</span>
							</button>
							<div class="org-chain-link" aria-hidden="true">
								<svg class="org-chain-arrow" viewBox="0 0 16 16">
									<path
										d="M8 2.25v8.5M4.25 8.25 8 13.25l3.75-5"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</div>
						</li>
					);
				})
			}
		</ol>

		<section class="org-selected" aria-labelledby="org-selected-name">
			<button
				type="button"
				class="org-up"
				data-org-select={manager ? crewSlug(manager.name) : undefined}
				hidden={!manager}
				aria-label={manager ? `Reports to ${manager.name}` : undefined}
			>
				<svg class="org-up-arrow" viewBox="0 0 16 16" aria-hidden="true">
					<path
						d="M8 13.75V5.25M4.25 7.75 8 2.75l3.75 5"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
				<span class="org-up-label">{manager ? `Reports to ${manager.name}` : ''}</span>
			</button>

			{
				selected && (
					<div class="org-selected-portrait">
						<button
							type="button"
							class="photo-trigger"
							id="org-selected-photo"
							data-member-index={getCrewIndex(selected.name)}
							aria-haspopup="dialog"
							aria-label={`View profile for ${selected.name}`}
						>
							<img
								class="crew-photo"
								data-theme-photo="dark"
								src={selected.image ? `/team/${selected.image}` : undefined}
								alt={selected.image ? `${selected.name} headshot` : ''}
								hidden={!selected.image}
								style={`object-fit: ${selected.imageFit ?? 'cover'}; object-position: ${selected.imagePosition ?? 'center'};`}
							/>
							<img
								class="crew-photo"
								data-theme-photo="light"
								src={selected.image ? `/team/light/${selected.lightImage ?? selected.image}` : undefined}
								alt=""
								aria-hidden="true"
								hidden={!selected.image}
								style={`object-fit: ${selected.imageFit ?? 'cover'}; object-position: ${selected.imagePosition ?? 'center'};`}
							/>
							<PhotoPlaceholder initials={getInitials(selected.name)} hidden={Boolean(selected.image)} />
						</button>
					</div>
				)
			}

			<h2 id="org-selected-name" class="org-selected-name" tabindex="-1">{selected?.name}</h2>
			<p class="org-selected-title">{selected?.title}</p>
		</section>

		<section class="org-reports-section" aria-labelledby="org-reports-heading">
			<h2 id="org-reports-heading" class="org-reports-heading">Direct reports</h2>
			<ul class="org-report-list">
				{
					crewMembers.map((member) => {
						const slug = crewSlug(member.name);
						const index = getCrewIndex(member.name);
						const reportTotal = getReportTotal(member.name, showSecret);
						return (
							<li
								class="org-report"
								data-org-slug={slug}
								data-secret={member.secret ? '' : undefined}
								hidden={!reportSlugs.has(slug)}
							>
								<CrewPhoto member={member} index={index} />
								<button type="button" class="org-report-select" data-org-select={slug}>
									<span class="org-person-copy">
										<span class="org-person-name">{member.name}</span>
										<span class="org-person-title">{member.title}</span>
									</span>
									<span class="org-report-meta" data-org-meta hidden={reportTotal === 0}>
										<span class="org-report-count">
											<span data-org-count-value>{reportTotal}</span>
											<span data-org-count-label>{reportTotal === 1 ? ' report' : ' reports'}</span>
										</span>
										<svg class="org-chevron" data-org-chevron viewBox="0 0 20 20" aria-hidden="true">
											<path
												d="M7 5 12.5 10 7 15"
												fill="none"
												stroke="currentColor"
												stroke-width="2.25"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									</span>
								</button>
							</li>
						);
					})
				}
			</ul>
			<p class="org-reports-empty" hidden={reports.length > 0}>No direct reports</p>
		</section>
	</div>
</div>

<script>
	import {
		crewMembers,
		crewSlug,
		getCrewIndex,
		getCrewMemberBySlug,
		getDirectReports,
		getInitials,
		getManagerChain,
		getReportTotal,
		getVisibleFallback,
		getVisibleRoot,
		isCrewMemberVisible,
		type CrewMember,
	} from '../../data/crew';
	import { RN_MODE_EVENT, type RnModeChangeDetail } from '../../lib/rn-mode';

	const browser = document.querySelector<HTMLElement>('[data-org-browser]');
	const stage = browser?.querySelector<HTMLElement>('.org-browser-stage');
	const chainList = browser?.querySelector<HTMLElement>('.org-chain-list');
	const reportList = browser?.querySelector<HTMLElement>('.org-report-list');
	const upButton = browser?.querySelector<HTMLButtonElement>('.org-up');
	const upLabel = upButton?.querySelector<HTMLElement>('.org-up-label');
	const selectedPhoto = browser?.querySelector<HTMLButtonElement>('#org-selected-photo');
	const selectedName = browser?.querySelector<HTMLElement>('#org-selected-name');
	const selectedTitle = browser?.querySelector<HTMLElement>('.org-selected-title');
	const reportsEmpty = browser?.querySelector<HTMLElement>('.org-reports-empty');

	if (
		browser &&
		stage &&
		chainList &&
		reportList &&
		upButton &&
		upLabel &&
		selectedPhoto &&
		selectedName &&
		selectedTitle &&
		reportsEmpty
	) {
		let showSecret = document.documentElement.hasAttribute('data-rn-mode');
		let requestedSlug = readHash();
		let paintedSlug = '';
		let booted = false;

		const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function readHash() {
			const raw = decodeURIComponent(location.hash.replace(/^#/, '')).trim().toLowerCase();
			return raw || null;
		}

		function defaultMember() {
			const nyle = getCrewMemberBySlug('nyle');
			if (nyle && isCrewMemberVisible(nyle, showSecret)) return nyle;
			return getVisibleRoot(showSecret);
		}

		function resolve(slug: string | null, keepCurrent = false) {
			const fallback = defaultMember();
			if (slug) {
				const requested = getCrewMemberBySlug(slug);
				if (!requested) return fallback;
				if (isCrewMemberVisible(requested, showSecret)) return requested;
				return getVisibleFallback(requested.name, showSecret) ?? fallback;
			}
			// Default view is Nyle. Keep the open person when RN Mode changes who is visible.
			if (keepCurrent && paintedSlug) {
				const current = getCrewMemberBySlug(paintedSlug);
				if (current && isCrewMemberVisible(current, showSecret)) return current;
				if (current) return getVisibleFallback(current.name, showSecret) ?? fallback;
			}
			return fallback;
		}

		function writeHash(mode: 'push' | 'replace' | 'none', slug: string) {
			if (mode === 'none') return;
			const next = `#${encodeURIComponent(slug)}`;
			if (decodeURIComponent(location.hash.replace(/^#/, '')).toLowerCase() === slug) return;
			const url = `${location.pathname}${location.search}${next}`;
			if (mode === 'push') history.pushState({ orgSlug: slug }, '', url);
			else history.replaceState({ orgSlug: slug }, '', url);
		}

		function orderRows(list: HTMLElement, members: CrewMember[]) {
			const rows = new Map<string, HTMLElement>();
			list.querySelectorAll<HTMLElement>(':scope > [data-org-slug]').forEach((row) => {
				rows.set(row.dataset.orgSlug || '', row);
				row.hidden = true;
			});
			for (const member of members) {
				const row = rows.get(crewSlug(member.name));
				if (!row) continue;
				row.hidden = false;
				const reportTotal = getReportTotal(member.name, showSecret);
				const value = row.querySelector<HTMLElement>('[data-org-count-value]');
				if (value) value.textContent = String(reportTotal);
				const label = row.querySelector<HTMLElement>('[data-org-count-label]');
				if (label) label.textContent = reportTotal === 1 ? ' report' : ' reports';
				const meta = row.querySelector<HTMLElement>('[data-org-meta]');
				if (meta) meta.hidden = reportTotal === 0;
				list.appendChild(row);
			}
			for (const row of rows.values()) {
				if (row.hidden) list.appendChild(row);
			}
		}

		function paintPhoto(member: CrewMember) {
			selectedPhoto.dataset.memberIndex = String(getCrewIndex(member.name));
			selectedPhoto.setAttribute('aria-label', `View profile for ${member.name}`);
			const images = selectedPhoto.querySelectorAll<HTMLImageElement>('.crew-photo');
			const placeholder = selectedPhoto.querySelector<HTMLElement>('.photo-placeholder');
			if (member.image) {
				images.forEach((image) => {
					const light = image.dataset.themePhoto === 'light';
					const file = light ? member.lightImage ?? member.image : member.image;
					image.src = `${light ? '/team/light/' : '/team/'}${file}`;
					image.alt = light ? '' : `${member.name} headshot`;
					image.style.objectFit = member.imageFit ?? 'cover';
					image.style.objectPosition = member.imagePosition ?? 'center';
					image.hidden = false;
				});
				if (placeholder) placeholder.hidden = true;
			} else {
				images.forEach((image) => {
					image.hidden = true;
					image.removeAttribute('src');
				});
				if (placeholder) {
					placeholder.hidden = false;
					const initials = placeholder.querySelector('.photo-icon');
					if (initials) initials.textContent = getInitials(member.name);
				}
			}
		}

		function paint(member: CrewMember, animate: boolean) {
			const slug = crewSlug(member.name);
			const chain = getManagerChain(member.name, showSecret);
			const reports = getDirectReports(member.name, showSecret);
			const manager = chain[chain.length - 1];

			orderRows(chainList, chain);
			orderRows(reportList, reports);
			chainList.hidden = chain.length === 0;

			if (manager) {
				upButton.hidden = false;
				upButton.dataset.orgSelect = crewSlug(manager.name);
				upButton.setAttribute('aria-label', `Reports to ${manager.name}`);
				upLabel.textContent = `Reports to ${manager.name}`;
			} else {
				upButton.hidden = true;
				delete upButton.dataset.orgSelect;
				upLabel.textContent = '';
			}

			paintPhoto(member);
			selectedName.textContent = member.name;
			selectedTitle.textContent = member.title;
			reportsEmpty.hidden = reports.length > 0;

			if (animate && paintedSlug !== slug) {
				stage.classList.remove('is-entering');
				void stage.offsetWidth;
				stage.classList.add('is-entering');
			}
			paintedSlug = slug;
		}

		function show(options: { history: 'push' | 'replace' | 'none'; focus?: boolean; scroll?: boolean; keepCurrent?: boolean }) {
			if (requestedSlug && !getCrewMemberBySlug(requestedSlug)) {
				requestedSlug = null;
				history.replaceState(null, '', `${location.pathname}${location.search}`);
			}

			const member = resolve(requestedSlug, options.keepCurrent);
			if (!member) return;
			const slug = crewSlug(member.name);
			const changed = paintedSlug !== slug;
			paint(member, booted && changed);
			writeHash(options.history, slug);
			document.documentElement.removeAttribute('data-org-pending');
			booted = true;

			if (options.scroll && changed) {
				stage.scrollIntoView({ block: 'start', behavior: reducedMotion() ? 'auto' : 'smooth' });
			}
			if (options.focus) selectedName.focus({ preventScroll: true });
		}

		browser.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const control = target.closest<HTMLElement>('[data-org-select]');
			if (!control || !browser.contains(control)) return;
			const slug = control.dataset.orgSelect;
			if (!slug || slug === paintedSlug) return;
			requestedSlug = slug;
			show({ history: 'push', focus: event.detail === 0, scroll: true });
		});

		window.addEventListener('popstate', () => {
			requestedSlug = readHash();
			show({ history: 'none', focus: true, scroll: true });
		});

		document.addEventListener(RN_MODE_EVENT, (event) => {
			const enabled = (event as CustomEvent<RnModeChangeDetail>).detail?.enabled;
			showSecret = Boolean(enabled);
			show({ history: 'replace', scroll: false, keepCurrent: true });
		});

		if (!crewMembers.length) document.documentElement.removeAttribute('data-org-pending');
		else show({ history: 'none' });
	}
</script>
