---
import CrewPhoto from './CrewPhoto.astro';
import type { CrewMember } from '../../data/crew';

interface Props {
	member: CrewMember;
	index: number;
}

const { member, index } = Astro.props;
---

<CrewPhoto member={member} index={index} />
<div class="crew-member-info">
	<h2>{member.name}</h2>
	<p>{member.title}</p>
</div>
