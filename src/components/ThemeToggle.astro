			class="theme-toggle-option"
			data-theme-value="light"
			aria-label="Light theme"
			aria-pressed="true"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.75"
				></circle>
				<path
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					d="M12 2.5v2.25M12 19.25V21.5M4.5 12H2.25M21.75 12H19.5M6.04 6.04l-1.59-1.59M19.55 19.55l-1.59-1.59M17.96 6.04l1.59-1.59M4.45 19.55l1.59-1.59"
				></path>
