		<button
			type="button"
			class="theme-toggle-option"
			data-theme-value="dark"
			aria-label="Dark theme"
			aria-pressed="false"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
