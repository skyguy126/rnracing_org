---
import '../styles/season2-announcement.css';
---

<button
	type="button"
	class="s2-banner"
	data-s2-banner
	aria-haspopup="dialog"
	aria-controls="s2-announcement"
>
	<span class="s2-banner__text">🎉 SEASON 2 - SPECIAL ANNOUNCEMENT 🎊</span>
</button>

<div
	id="s2-announcement"
	class="s2-overlay"
	data-s2-overlay
	role="dialog"
	aria-modal="true"
	aria-labelledby="s2-announcement-title"
	hidden
>
	<div class="s2-dimmer" data-s2-dimmer></div>
	<canvas class="s2-confetti" data-s2-confetti aria-hidden="true"></canvas>
	<canvas class="s2-webgl" data-s2-webgl aria-hidden="true"></canvas>
	<div class="s2-fallback" data-s2-fallback hidden>
		<div class="s2-coin" data-s2-coin>
			<img
				class="s2-coin__face s2-coin__face--front"
				data-s2-face
				alt=""
				width="1231"
				height="975"
			/>
			<img
				class="s2-coin__face s2-coin__face--back"
				data-s2-face
				alt=""
				width="1231"
				height="975"
			/>
		</div>
	</div>
	<p class="s2-caption" data-s2-caption>
		<span class="s2-winner">WINNER</span>
		<span class="s2-winner-sub"><span>HALLOWEEN MEETS GASOLINE</span> <span>BUTTONWILLOW 2026</span></span>
	</p>
	<div class="s2-a11y">
		<h2 id="s2-announcement-title" class="s2-sr">Season 2 announcement</h2>
		<button type="button" class="s2-dismiss" data-s2-dismiss aria-label="Close">
			<span aria-hidden="true">×</span>
		</button>
	</div>
</div>

<script>
	import { initSeason2Announcement } from '../lib/season2-announcement';

	initSeason2Announcement();
</script>
