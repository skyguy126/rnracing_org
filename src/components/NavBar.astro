---
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/$/, '') || '/') === currentPath;
---

<header class="site-header" data-nav-menu>
	<nav class="nav" aria-label="Main navigation">
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true">RN</span>
			<span class="brand-name">RN Racing</span>
		</a>

		<div class="nav-actions">
			<ul class="nav-links nav-links--inline">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a
								class:list={['nav-link', { 'is-active': isActive(link.href) }]}
								href={link.href}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>

			<ThemeToggle />

			<button
				type="button"
				class="nav-menu-toggle"
				aria-expanded="false"
				aria-controls="nav-menu-panel"
				aria-label="Open menu"
			>
				<span class="nav-menu-toggle-icon" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</nav>

	<div id="nav-menu-panel" class="nav-menu-panel" hidden>
		<ul class="nav-links nav-links--menu">
			{
				NAV_LINKS.map((link) => (
					<li>
						<a
							class:list={['nav-link', 'nav-link--menu', { 'is-active': isActive(link.href) }]}
							href={link.href}
							aria-current={isActive(link.href) ? 'page' : undefined}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<script>
	import { initNavMenu } from '../lib/nav-menu';

	document.querySelectorAll('[data-nav-menu]').forEach((root) => {
		initNavMenu(root as HTMLElement);
	});
</script>

<style is:global>
	body.nav-menu-open {
		overflow: hidden;
	}
</style>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(16px);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 1rem var(--page-gutter);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		min-width: 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--text);
		text-decoration: none;
		flex-shrink: 0;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: var(--control-size);
		height: var(--control-size);
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		color: var(--blue);
		font-family: var(--font-display);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1;
	}

	.brand-name {
		display: flex;
		align-items: center;
		min-height: var(--control-size);
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1;
	}

	.nav-links {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-links--inline {
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.125rem;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		padding: 0.4375rem 0.75rem;
		border-radius: 0.375rem;
		color: var(--muted);
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 500;
		line-height: var(--display-line);
		text-decoration: none;
		background: transparent;
		transition: color 0.15s ease;
	}

	.nav-link:hover:not(.is-active) {
		color: var(--text);
	}

	.nav-link.is-active,
	.nav-link.is-active:hover {
		color: var(--blue-soft);
	}

	.nav-menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: var(--control-size);
		height: var(--control-size);
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		background: var(--surface);
		color: var(--muted);
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.nav-menu-toggle:hover,
	.nav-menu-toggle[aria-expanded='true'] {
		color: var(--text);
		border-color: color-mix(in srgb, var(--blue) 35%, var(--border));
		background: var(--bg);
	}

	.nav-menu-toggle-icon {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.1875rem;
		width: 1rem;
		height: 1rem;
	}

	.nav-menu-toggle-icon span {
		display: block;
		width: 100%;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 0.15s ease,
			opacity 0.15s ease;
	}

	.nav-menu-toggle[aria-expanded='true'] .nav-menu-toggle-icon span:nth-child(1) {
		transform: translateY(0.3125rem) rotate(45deg);
	}

	.nav-menu-toggle[aria-expanded='true'] .nav-menu-toggle-icon span:nth-child(2) {
		opacity: 0;
	}

	.nav-menu-toggle[aria-expanded='true'] .nav-menu-toggle-icon span:nth-child(3) {
		transform: translateY(-0.3125rem) rotate(-45deg);
	}

	.nav-menu-panel {
		display: none;
		border-top: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		backdrop-filter: blur(16px);
	}

	.nav-menu-panel:not([hidden]) {
		display: block;
	}

	.nav-links--menu {
		flex-direction: column;
		align-items: stretch;
		gap: 0.25rem;
		width: 100%;
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 0.75rem var(--page-gutter) 1rem;
	}

	.nav-link--menu {
		justify-content: flex-start;
		width: 100%;
		padding: 0.75rem 0;
		font-size: 1.25rem;
		text-align: left;
	}

	@media (max-width: 767px) {
		.nav {
			padding-block: 0.875rem;
		}

		.nav-actions {
			gap: 0.5rem;
		}

		.nav-links--inline {
			display: none;
		}

		.nav-menu-toggle {
			display: inline-flex;
		}
	}

	@media (max-width: 480px) {
		.brand-name {
			display: none;
		}
	}
</style>
