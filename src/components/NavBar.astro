---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/team', label: 'The Team' },
	{ href: 'https://www.instagram.com/_rnracing_/', label: 'Instagram', external: true },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
	<nav class="nav" aria-label="Main navigation">
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true">RN</span>
			<span class="brand-name">RN Racing</span>
		</a>

		<div class="nav-actions">
			<ul class="nav-links">
				{
					navLinks.map((link) => {
						const linkPath = link.external ? null : link.href.replace(/\/$/, '') || '/';
						const isActive = linkPath !== null && linkPath === currentPath;

						return (
							<li>
								<a
									class:list={['nav-link', { 'is-active': isActive }]}
									href={link.href}
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noopener noreferrer' : undefined}
									aria-current={isActive ? 'page' : undefined}
								>
									{link.label}
								</a>
							</li>
						);
					})
				}
			</ul>
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(16px);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 1rem 1.5rem;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		min-width: 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--text);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--text);
	}

	.brand-mark {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		min-height: 2rem;
		padding-block: 0.125rem;
		border: 1px solid var(--border);
		border-radius: 0.375rem;
		color: var(--blue);
		font-family: var(--font-display);
		font-size: 0.8125rem;
		line-height: var(--display-line);
	}

	.brand-name {
		font-family: var(--font-display);
		font-size: 1.125rem;
		line-height: var(--display-line);
		padding-bottom: var(--display-descender);
	}

	.nav-links {
		display: flex;
		align-items: flex-end;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-link {
		display: inline-flex;
		align-items: flex-end;
		padding: 0.375rem 0.75rem 0.5rem;
		border-radius: 0.375rem;
		color: var(--muted);
		font-family: var(--font-display);
		font-size: 1rem;
		line-height: var(--display-line);
		text-decoration: none;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	.nav-link:hover,
	.nav-link.is-active {
		background: var(--surface);
		color: var(--text);
	}

	.nav-link.is-active {
		color: var(--blue-soft);
	}

	@media (max-width: 640px) {
		.nav {
			padding: 0.875rem 1rem;
		}

		.nav-actions {
			gap: 0.5rem;
		}

		.nav-link {
			padding: 0.375rem 0.625rem 0.5rem;
			font-size: 0.875rem;
		}
	}

	@media (max-width: 480px) {
		.brand-name {
			display: none;
		}
	}
</style>
