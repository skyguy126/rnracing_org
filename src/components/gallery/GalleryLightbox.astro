---
---

<div class="gallery-lightbox" data-gallery-lightbox hidden>
	<div class="gallery-lightbox__backdrop" aria-hidden="true"></div>
	<div
		class="gallery-lightbox__panel"
		role="dialog"
		aria-modal="true"
		aria-label="Photograph"
		tabindex="-1"
		data-lightbox-panel
	>
		<button type="button" class="gallery-lightbox__close" aria-label="Close photograph">
			<span aria-hidden="true">&times;</span>
		</button>
		<figure class="gallery-lightbox__figure">
			<img class="gallery-lightbox__image" data-lightbox-image alt="" hidden />
		</figure>
	</div>
</div>

<style>
	.gallery-lightbox {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-items: center;
		padding: 1.5rem;
		cursor: zoom-out;
	}

	.gallery-lightbox[hidden] {
		display: none;
	}

	.gallery-lightbox__backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--black) 55%, transparent);
		backdrop-filter: blur(8px);
	}

	.gallery-lightbox__panel {
		position: relative;
		display: grid;
		place-items: center;
		width: min(100%, 90vw);
		max-height: min(92dvh, 56rem);
		padding: 1.25rem 1.25rem 1rem;
		border: 1px solid var(--border);
		border-radius: 0.875rem;
		background: var(--surface);
		box-shadow: 0 24px 64px color-mix(in srgb, var(--black) 35%, transparent);
		outline: none;
	}

	.gallery-lightbox__close {
		position: absolute;
		top: 0.875rem;
		right: 0.875rem;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg);
		color: var(--muted);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
	}

	.gallery-lightbox__close:hover,
	.gallery-lightbox__close:focus-visible {
		color: var(--text);
		border-color: color-mix(in srgb, var(--blue) 35%, var(--border));
		outline: none;
	}

	.gallery-lightbox__figure {
		margin: 0;
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		max-width: 100%;
	}

	.gallery-lightbox__image {
		display: block;
		max-width: min(90vw, 100%);
		max-height: min(88dvh, 48rem);
		width: auto;
		height: auto;
		object-fit: contain;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--bg) 70%, var(--surface));
	}

	.gallery-lightbox__image[hidden] {
		display: none;
	}

	@media (max-width: 640px) {
		.gallery-lightbox {
			padding: 1rem;
		}

		.gallery-lightbox__panel {
			width: 100%;
			padding: 3.25rem 0.875rem 0.875rem;
		}

		.gallery-lightbox__image {
			max-height: min(78dvh, 40rem);
		}
	}
</style>

<style is:global>
	body.modal-open {
		overflow: hidden;
	}
</style>
