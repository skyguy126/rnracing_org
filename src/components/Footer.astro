---
import { SITE } from '../data/site';

const socialLinks = [
	{
		label: 'Instagram',
		href: SITE.instagram,
		external: true,
		icon: 'instagram',
	},
	{
		label: 'YouTube',
		href: SITE.youtube,
		external: true,
		icon: 'youtube',
	},
	{ label: 'Twitter', href: SITE.twitter, external: true, icon: 'twitter' },
	{ label: 'GitHub', href: SITE.github, external: true, icon: 'github' },
] as const;

/** YC-style batch: F/W/S/S (Fall/Winter/Spring/Summer) + two-digit year. */
function fundingBatch(date = new Date()) {
	const month = date.getMonth(); // 0–11
	// W: Dec–Feb · S: Mar–May (Spring) · S: Jun–Aug (Summer) · F: Sep–Nov
	const season = month === 11 || month <= 1 ? 'W' : month <= 7 ? 'S' : 'F';
	const year = String(date.getFullYear()).slice(-2);
	return `${season}${year}`;
}

const batch = fundingBatch();
---

<footer class="site-footer">
	<div class="layout-inner site-footer__inner">
		<span class="footer-emblem" tabindex="0" role="img" aria-label="Winners of Buttonwillow 2026 Halloween Meets Gasoline Award" data-tooltip="Winners of Buttonwillow 2026 Halloween Meets Gasoline Award">
			<img src="/season-2/season-2-emblem-transparent.svg" alt="" aria-hidden="true" width="1231" height="975" loading="lazy" />
		</span>
		<ul class="footer-social" aria-label="Social links">
			{
				socialLinks.map((link) => (
					<li>
						<a
							class="footer-social-link"
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
							aria-label={link.label}
						>
							{link.icon === 'instagram' && (
								<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<rect
										x="3.5"
										y="3.5"
										width="17"
										height="17"
										rx="5"
										ry="5"
										fill="none"
										stroke="currentColor"
										stroke-width="1.75"
									/>
									<circle
										cx="12"
										cy="12"
										r="4.1"
										fill="none"
										stroke="currentColor"
										stroke-width="1.75"
									/>
									<circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" />
								</svg>
							)}
							{link.icon === 'youtube' && (
								<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path
										fill="currentColor"
										d="M23.5 6.2a3.02 3.02 0 0 0-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.56A3.02 3.02 0 0 0 .5 6.2 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.8 3.02 3.02 0 0 0 2.12 2.14C4.5 20.5 12 20.5 12 20.5s7.5 0 9.38-.56a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.8ZM9.75 15.02V8.98L15.5 12l-5.75 3.02Z"
									/>
								</svg>
							)}
							{link.icon === 'twitter' && (
								<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path
										fill="currentColor"
										d="M17.3 4.5h2.2l-4.8 5.5 5.6 7.5h-4.4l-3.5-4.6-4 4.6H6l5.1-5.9L5.7 4.5h4.5l3.2 4.2 3.9-4.2Zm-.8 12.1h1.2L8.9 5.9H7.6l8.9 10.7Z"
									/>
								</svg>
							)}
							{link.icon === 'github' && (
								<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path
										fill="currentColor"
										d="M12 3c-4.97 0-9 4.03-9 9 0 3.98 2.44 7.39 5.91 8.79.43.08.59-.19.59-.42 0-.21-.01-.91-.01-1.65-2.37.52-2.87-.57-2.87-.57-.39-.98-.96-1.24-.96-1.24-.78-.53.06-.52.06-.52.86.06 1.32.89 1.32.89.77 1.32 2.03.94 2.52.72.08-.56.3-.94.54-1.16-1.89-.21-3.88-.95-3.88-4.23 0-.93.33-1.69.87-2.29-.09-.21-.38-1.07.08-2.23 0 0 .71-.23 2.33.87a8.06 8.06 0 0 1 2.14-.29c.73 0 1.46.1 2.14.29 1.62-1.1 2.33-.87 2.33-.87.46 1.16.17 2.02.08 2.23.54.6.87 1.36.87 2.29 0 3.29-1.99 4.02-3.89 4.23.31.27.59.8.59 1.62 0 1.17-.01 2.11-.01 2.4 0 .23.16.51.6.42A9.01 9.01 0 0 0 21 12c0-4.97-4.03-9-9-9Z"
									/>
								</svg>
							)}
						</a>
					</li>
				))
			}
		</ul>
		<ul class="footer-compliance" aria-label="Compliance">
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M12 2.5 4.5 5.5v5.7c0 4.6 3.1 8.6 7.5 10.3 4.4-1.7 7.5-5.7 7.5-10.3V5.5L12 2.5Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
					<path d="M12 8.5v6M9 11.5h6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
				</svg>
				HIPAA
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.75" />
					<path d="m8 12.3 2.8 2.8L16.3 9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				SOC 2
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					{Array.from({ length: 12 }, (_, i) => {
						const angle = (i / 12) * Math.PI * 2;
						return <circle cx={12 + 8 * Math.sin(angle)} cy={12 - 8 * Math.cos(angle)} r="1.3" fill="currentColor" />;
					})}
					<rect x="9" y="11" width="6" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
					<path d="M10.5 11V9.8a1.5 1.5 0 0 1 3 0V11" fill="none" stroke="currentColor" stroke-width="1.5" />
				</svg>
				GDPR
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M12 3.2 14.6 9l6.2.6-4.7 4.2 1.4 6.1L12 16.6l-5.5 3.3 1.4-6.1L3.2 9.6 9.4 9 12 3.2Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
				</svg>
				YKWIS
			</li>
			<li class="footer-compliance__negative">
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.75" />
					<path d="m8.8 8.8 6.4 6.4M15.2 8.8l-6.4 6.4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
				</svg>
				Proudly OSHA Non-Compliant
			</li>
		</ul>
		<ul class="footer-compliance footer-funding" aria-label="Funding">
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M12 20.5V4M5.5 10.5 12 4l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				Y Combinator <span data-funding-batch>{batch}</span>
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M3.5 17.5 9 12l4 4 7.5-8.5M15 7.5h5.5V13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				A16Z <span data-funding-batch>{batch}</span>
			</li>
		</ul>
		<p>&copy; <span data-copyright-year>{new Date().getFullYear()}</span> {SITE.name}</p>
	</div>
</footer>

<script>
	const yearEl = document.querySelector('[data-copyright-year]');
	if (yearEl) {
		yearEl.textContent = String(new Date().getFullYear());
	}

	function fundingBatch(date = new Date()) {
		const month = date.getMonth();
		const season = month === 11 || month <= 1 ? 'W' : month <= 7 ? 'S' : 'F';
		return `${season}${String(date.getFullYear()).slice(-2)}`;
	}

	const batch = fundingBatch();
	document.querySelectorAll('[data-funding-batch]').forEach((el) => {
		el.textContent = batch;
	});
</script>
