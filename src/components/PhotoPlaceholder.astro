---
interface Props {
	initials: string;
	large?: boolean;
}

const { initials, large = false } = Astro.props;
---

<div class:list={['photo-placeholder', { 'photo-placeholder--large': large }]}>
	<span class="photo-icon">{initials}</span>
</div>

<style>
	.photo-placeholder {
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background:
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--surface) 88%, var(--muted)) 0%,
				var(--surface) 100%
			);
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			transform 0.15s ease;
	}

	.photo-placeholder--large {
		border-radius: 0.75rem;
		background:
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--surface) 70%, var(--blue)) 0%,
				var(--bg) 100%
			);
	}

	.photo-icon {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 600;
		line-height: var(--display-line);
		padding-bottom: var(--display-descender);
		color: color-mix(in srgb, var(--muted) 70%, transparent);
	}

	.photo-placeholder--large .photo-icon {
		font-size: clamp(2.5rem, 8vw, 4rem);
		color: color-mix(in srgb, var(--muted) 75%, var(--text));
	}
</style>
